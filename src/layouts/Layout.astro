---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import NightSky from '../components/NightSky.astro';
import FloatingProjectsBtn from '../components/FloatingProjectsBtn.astro';
import LanguageChanger from '../components/LanguageChanger.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
}

const {
  title = 'Faycal Rafa | Fullstack Engineer',
  description = 'Personal developer portfolio, software architecture showcase, and BookReader Android flagship hobby project of Faycal Rafa.',
  image = '/images/og-preview.png',
  articleDate,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://faycalrafa.github.io');
const fullImageURL = new URL(image, Astro.site ?? 'https://faycalrafa.github.io').toString();
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Faycal Rafa" />
    <meta name="generator" content={Astro.generator} />

    <!-- Browser Color Scheme Hint (Strict Dark Theme default) -->
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />
    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageURL} />

    <!-- Google Fonts: Cairo for modern Arabic typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Astro 5 Client Router (View Transitions with Prefetching) -->
    <ClientRouter />

    <!--
      CRITICAL ZERO-FOUC SCRIPTS
      Executes synchronously before body rendering to guarantee dark night mode & correct language/direction immediately.
    -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored || prefersDark || true) {
            document.documentElement.classList.add('dark');
          }
          localStorage.setItem('theme', 'dark');
          const meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.content = 'dark';

          // Zero-FOUC Language & RTL Restoration
          const lang = localStorage.getItem('portfolio_lang');
          if (lang === 'ar') {
            document.documentElement.lang = 'ar';
            document.documentElement.dir = 'rtl';
            document.documentElement.classList.add('rtl-layout');
          } else if (lang === 'fr') {
            document.documentElement.lang = 'fr';
            document.documentElement.dir = 'ltr';
          }
        } catch (e) {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>
  <body class="bg-[#060812] text-zinc-100 antialiased selection:bg-blue-600 selection:text-white transition-colors duration-200">
    <!-- Top Fluid Luminous Navigation Progress Line -->
    <div
      id="route-progress-bar"
      class="fixed top-0 left-0 h-[3px] w-0 z-50 bg-gradient-to-r from-sky-400 via-blue-500 to-indigo-500 shadow-[0_0_10px_rgba(56,189,248,0.8),0_0_5px_rgba(99,102,241,0.6)] transition-all duration-200 pointer-events-none opacity-0"
      aria-hidden="true"
    ></div>

    <!-- Skip to main content link for keyboard and screen reader accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-md focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <!-- Celestial Night Sky Background & Glowing Moon -->
    <NightSky />

    <!-- Floating On-Screen Action Capsule: Language Changer on Home, Navigation on Other Pages -->
    {isHome ? (
      <LanguageChanger variant="floating" />
    ) : (
      <FloatingProjectsBtn />
    )}

    <div class="relative flex min-h-screen flex-col">
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <Footer />
      <CommandPalette />
      <WhatsAppFab />
    </div>

    <!--
      ROUTING PERFORMANCE CONTROLLER & VIEW TRANSITIONS LIFECYCLE
    -->
    <script>
      function enforceDarkMode() {
        document.documentElement.classList.add('dark');
        const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
        if (meta) meta.content = 'dark';
        try {
          localStorage.setItem('theme', 'dark');
        } catch (e) {}
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: 'dark' } }));
      }

      // Route Progress Bar animation controller
      let progressBar = document.getElementById('route-progress-bar');
      let progressTimer: any = null;

      document.addEventListener('astro:before-preparation', () => {
        progressBar = document.getElementById('route-progress-bar');
        if (!progressBar) return;
        progressBar.style.opacity = '1';
        progressBar.style.width = '35%';
        clearTimeout(progressTimer);
        progressTimer = setTimeout(() => {
          if (progressBar) progressBar.style.width = '75%';
        }, 120);
      });

      document.addEventListener('astro:after-preparation', () => {
        if (progressBar) progressBar.style.width = '90%';
      });

      document.addEventListener('astro:after-swap', () => {
        enforceDarkMode();
      });

      document.addEventListener('astro:page-load', () => {
        enforceDarkMode();
        progressBar = document.getElementById('route-progress-bar');
        if (progressBar) {
          progressBar.style.width = '100%';
          setTimeout(() => {
            if (progressBar) {
              progressBar.style.opacity = '0';
              setTimeout(() => {
                if (progressBar) progressBar.style.width = '0%';
              }, 200);
            }
          }, 150);
        }
      });

      // OS theme preference change listener (maintains dark mode contract)
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        enforceDarkMode();
      });
    </script>
  </body>
</html>
