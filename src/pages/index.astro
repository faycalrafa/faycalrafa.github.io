---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BentoGrid from '../components/BentoGrid.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
---

<Layout
  title="Faycal Rafa — Senior Software Engineer & Technical Lead"
  description="Personal developer portfolio, software architecture leadership, and BookReader Android flagship hobby project of Faycal Rafa."
>
  <!-- Hero Section & Inline CV Modal Viewer (F03) -->
  <Hero />

  <!-- Skills Matrix Bento Grid Section (F04) -->
  <BentoGrid />

  <!-- Interactive Career Journey Timeline (F05) -->
  <CareerTimeline />

  <!-- Contact & Opportunities Section -->
  <section id="contact" class="border-t border-zinc-200/80 bg-zinc-50/50 py-16 dark:border-zinc-800/80 dark:bg-zinc-900/20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100">
          Let's Build Something Exceptional
        </h2>
        <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
          Interested in discussing a Senior Software Engineer or Technical Lead opportunity? Feel free to reach out directly.
        </p>
        <div class="mt-6 flex items-center gap-4">
          <a
            href="mailto:rafafaycal@gmail.com"
            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-500 dark:bg-blue-500 dark:hover:bg-blue-400 transition-colors"
          >
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 4h14a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V5a1 1 0 011-1z" />
              <path d="M3 5l7 5 7-5" />
            </svg>
            <span>rafafaycal@gmail.com</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
