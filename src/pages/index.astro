---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BentoGrid from '../components/BentoGrid.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
---

<Layout
  title="Faycal Rafa | Senior Software Engineer & Technical Lead"
  description="Personal developer portfolio, software architecture leadership, and BookReader Android flagship hobby project of Faycal Rafa."
>
  <!-- Hero Section & Inline CV Modal Viewer (F03) -->
  <Hero />

  <!-- Skills Matrix Bento Grid Section (F04) -->
  <BentoGrid />

  <!-- Interactive Career Journey Timeline (F05) -->
  <CareerTimeline />

  <!-- Contact & Opportunities Section -->
  <section id="contact" class="border-t border-zinc-800/80 bg-zinc-900/20 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300">
          <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
          <span>Open to Opportunities</span>
        </div>

        <h2 class="mt-4 text-2xl font-bold tracking-tight text-zinc-100 sm:text-3xl">
          Get in Touch &amp; Opportunities
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-zinc-400">
          Available for <strong class="text-zinc-100">Senior Software Engineer</strong>, <strong class="text-zinc-100">Technical Lead</strong>, and <strong class="text-zinc-100">Freelance / Contract Development</strong> opportunities worldwide. Whether you have an immediate opening, a high-impact consulting project, or a greenfield build, feel free to reach out directly.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <!-- WhatsApp Direct CTA -->
          <a
            href="https://wa.me/213540980238"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white shadow-xs hover:bg-emerald-500 transition-colors"
            aria-label="Direct WhatsApp Chat with Faycal Rafa"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
            <span>WhatsApp (+213 540 98 02 38)</span>
          </a>

          <!-- Email -->
          <a
            href="mailto:rafafaycal@gmail.com"
            class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-500 transition-colors"
          >
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 4h14a1 1 0 011 1v10a1 1 0 01-1 1H3a1 1 0 01-1-1V5a1 1 0 011-1z" />
              <path d="M3 5l7 5 7-5" />
            </svg>
            <span>rafafaycal@gmail.com</span>
          </a>

          <!-- Direct Phone -->
          <a
            href="tel:+213540980238"
            class="inline-flex items-center gap-2 rounded-xl border border-zinc-800 bg-zinc-900 px-4 py-2.5 text-xs font-semibold text-zinc-200 hover:bg-zinc-800 transition-colors"
          >
            <svg class="h-4 w-4 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <span>Call +213 540 98 02 38</span>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/faycal-rafa-89a366249"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-blue-500/20 bg-blue-950/30 px-4 py-2.5 text-xs font-semibold text-blue-400 hover:bg-blue-900/40 transition-colors"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
            </svg>
            <span>LinkedIn Profile</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
