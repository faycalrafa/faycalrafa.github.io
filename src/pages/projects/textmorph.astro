  <!-- ═══════════════════ SHOWCASE CLIENT CONTROLLER ═══════════════════ -->
  <script define:vars={{ screens: APP_SCREENS }}>
    function initAppShowcase() {
      let activeIndex = 0;
      let activeViewMode = 'screen'; // 'screen' | 'playstore'

      const screenImg = document.getElementById('mockup-screen-img');
      const incomingImg = document.getElementById('mockup-screen-incoming');
      const detailTag = document.getElementById('detail-tag');
      const detailNum = document.getElementById('detail-num');
      const detailTitle = document.getElementById('detail-title');
      const detailSubtitle = document.getElementById('detail-subtitle');
      const detailDesc = document.getElementById('detail-desc');
      const detailHighlights = document.getElementById('detail-highlights');
      const detailTech = document.getElementById('detail-tech');

      const tabButtons = document.querySelectorAll('.screen-tab-btn');
      const thumbnailCards = document.querySelectorAll('.thumbnail-card');
      const prevBtn = document.getElementById('btn-prev-screen');
      const nextBtn = document.getElementById('btn-next-screen');

      const phoneTrigger = document.getElementById('phone-screen-trigger');
      const lightbox = document.getElementById('screenshot-lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxTitle = document.getElementById('lightbox-title');
      const lightboxCloseBtn = document.getElementById('lightbox-close-btn');

      const viewModeScreenBtn = document.getElementById('view-mode-screen');
      const viewModePlaystoreBtn = document.getElementById('view-mode-playstore');

      // Preload all screenshot & playstore images into browser memory to eliminate image decoding lag
      screens.forEach((s) => {
        const img1 = new Image();
        img1.src = s.image;
        if (s.playstoreImage) {
          const img2 = new Image();
          img2.src = s.playstoreImage;
        }
      });

      let isImageTransitioning = false;
      let transitionTimer = null;

      // Mobile lock indicator elements
      const mobileSnapCount = document.getElementById('mobile-snap-count');
      const mobileSnapHint = document.getElementById('mobile-snap-hint');
      const mobileSnapDot = document.getElementById('mobile-snap-dot');
      const mobileSnapUnlockBtn = document.getElementById('mobile-snap-unlock-btn');

      function getActiveImageUrl(idx) {
        const data = screens[idx];
        if (!data) return '';
        return activeViewMode === 'playstore' && data.playstoreImage ? data.playstoreImage : data.image;
      }

      function updateMobileIndicator() {
        if (!mobileSnapCount) return;
        mobileSnapCount.textContent = `Screen ${activeIndex + 1} of ${screens.length}`;
        if (mobileSnapHint) {
          mobileSnapHint.textContent = activeIndex === screens.length - 1 ? 'Scroll down for architecture' : 'Swipe to change';
        }
        if (mobileSnapDot) {
          mobileSnapDot.className = activeIndex === screens.length - 1 ? 'h-2 w-2 rounded-full bg-emerald-400' : 'h-2 w-2 rounded-full bg-emerald-400 animate-pulse';
        }
        if (mobileSnapUnlockBtn) {
          if (activeIndex === screens.length - 1) {
            mobileSnapUnlockBtn.textContent = 'Continue ↓';
            mobileSnapUnlockBtn.onclick = () => {
              const nextSec = document.getElementById('features-heading');
              if (nextSec) nextSec.scrollIntoView({ behavior: 'smooth' });
            };
          } else {
            mobileSnapUnlockBtn.textContent = 'Next ↓';
            mobileSnapUnlockBtn.onclick = () => {
              setScreen(activeIndex + 1, 'forward');
            };
          }
        }
      }

      function setScreen(index, direction) {
        if (index < 0) index = screens.length - 1;
        if (index >= screens.length) index = 0;
        if (index === activeIndex && !isImageTransitioning) return;

        const prevIndex = activeIndex;
        activeIndex = index;

        const data = screens[activeIndex];
        if (!data) return;

        const effectiveDirection = direction || (index >= prevIndex ? 'forward' : 'backward');
        const targetImage = getActiveImageUrl(activeIndex);

        // Smooth image transition without any black screen or flash
        if (screenImg && incomingImg) {
          if (transitionTimer) clearTimeout(transitionTimer);

          const isForward = effectiveDirection === 'forward';
          const slideInFrom = isForward ? '48px' : '-48px';
          const slideOutTo = isForward ? '-48px' : '48px';

          incomingImg.src = targetImage;
          incomingImg.alt = data.title;

          incomingImg.style.transition = 'none';
          incomingImg.style.opacity = '0';
          incomingImg.style.transform = `translateY(${slideInFrom}) scale(0.97)`;

          screenImg.style.transition = 'none';
          screenImg.style.opacity = '1';
          screenImg.style.transform = 'translateY(0) scale(1)';

          void incomingImg.offsetHeight;

          isImageTransitioning = true;
          const animCurve = 'cubic-bezier(0.16, 1, 0.3, 1)';
          incomingImg.style.transition = `opacity 340ms ${animCurve}, transform 340ms ${animCurve}`;
          incomingImg.style.opacity = '1';
          incomingImg.style.transform = 'translateY(0) scale(1)';

          screenImg.style.transition = `opacity 340ms ${animCurve}, transform 340ms ${animCurve}`;
          screenImg.style.opacity = '0';
          screenImg.style.transform = `translateY(${slideOutTo}) scale(0.97)`;

          transitionTimer = setTimeout(() => {
            screenImg.src = targetImage;
            screenImg.alt = data.title;
            screenImg.style.transition = 'none';
            screenImg.style.opacity = '1';
            screenImg.style.transform = 'none';

            incomingImg.style.transition = 'none';
            incomingImg.style.opacity = '0';
            incomingImg.style.transform = 'none';
            isImageTransitioning = false;
          }, 350);
        } else if (screenImg) {
          screenImg.src = targetImage;
          screenImg.alt = data.title;
        }

        // Subtly transition details container in sync
        const detailsContainer = document.getElementById('screen-details-container');
        if (detailsContainer) {
          detailsContainer.style.opacity = '0.5';
          detailsContainer.style.transform = effectiveDirection === 'forward' ? 'translateY(4px)' : 'translateY(-4px)';
          setTimeout(() => {
            detailsContainer.style.opacity = '1';
            detailsContainer.style.transform = 'translateY(0)';
          }, 80);
        }

        // Update Details text
        if (detailTag) detailTag.textContent = data.tag;
        if (detailNum) detailNum.textContent = `Screen ${data.num} / 05`;
        if (detailTitle) detailTitle.textContent = data.title;
        if (detailSubtitle) detailSubtitle.textContent = data.subtitle;
        if (detailDesc) detailDesc.textContent = data.description;
        if (detailTech) detailTech.textContent = data.tech;

        if (detailHighlights && data.highlights) {
          detailHighlights.innerHTML = data.highlights
            .map(
              (h) => `
              <li class="flex items-start gap-2.5">
                <svg class="h-4 w-4 shrink-0 text-emerald-500 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
                <span>${h}</span>
              </li>`
            )
            .join('');
        }

        // Update tabs active state
        tabButtons.forEach((btn, idx) => {
          const isSelected = idx === activeIndex;
          btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          if (isSelected) {
            btn.className = 'screen-tab-btn inline-flex items-center gap-2 rounded-xl px-3.5 py-2 text-xs sm:text-sm font-semibold transition-all cursor-pointer select-none bg-emerald-600 text-white shadow-md shadow-emerald-600/30 ring-2 ring-emerald-500/50';
          } else {
            btn.className = 'screen-tab-btn inline-flex items-center gap-2 rounded-xl px-3.5 py-2 text-xs sm:text-sm font-semibold transition-all cursor-pointer select-none bg-white text-zinc-700 hover:bg-emerald-50/80 border border-zinc-200 dark:bg-zinc-800/80 dark:text-zinc-300 dark:border-zinc-700 dark:hover:bg-zinc-800';
          }
        });

        // Update thumbnails active state
        thumbnailCards.forEach((thumb, idx) => {
          const isSelected = idx === activeIndex;
          if (isSelected) {
            thumb.className = 'thumbnail-card group relative rounded-xl border p-2 text-left transition-all cursor-pointer border-emerald-500 bg-emerald-500/10 ring-2 ring-emerald-500/30';
          } else {
            thumb.className = 'thumbnail-card group relative rounded-xl border p-2 text-left transition-all cursor-pointer border-zinc-200/90 bg-white dark:border-zinc-800 dark:bg-zinc-900/60 hover:border-emerald-400/60';
          }
        });

        updateMobileIndicator();
      }

      function updateViewMode(mode) {
        activeViewMode = mode;
        if (viewModeScreenBtn && viewModePlaystoreBtn) {
          if (mode === 'screen') {
            viewModeScreenBtn.className = 'view-mode-btn px-2.5 py-1.5 rounded-lg transition-all cursor-pointer bg-white text-emerald-800 shadow-xs dark:bg-emerald-600 dark:text-white';
            viewModePlaystoreBtn.className = 'view-mode-btn px-2.5 py-1.5 rounded-lg transition-all cursor-pointer text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200';
          } else {
            viewModePlaystoreBtn.className = 'view-mode-btn px-2.5 py-1.5 rounded-lg transition-all cursor-pointer bg-white text-emerald-800 shadow-xs dark:bg-emerald-600 dark:text-white';
            viewModeScreenBtn.className = 'view-mode-btn px-2.5 py-1.5 rounded-lg transition-all cursor-pointer text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200';
          }
        }

        // Update thumbnail images
        document.querySelectorAll('.thumbnail-card-img').forEach((img, idx) => {
          img.src = getActiveImageUrl(idx);
        });

        // Refresh active screen with new view mode image
        if (screenImg) {
          screenImg.src = getActiveImageUrl(activeIndex);
        }
      }

      if (viewModeScreenBtn) viewModeScreenBtn.addEventListener('click', () => updateViewMode('screen'));
      if (viewModePlaystoreBtn) viewModePlaystoreBtn.addEventListener('click', () => updateViewMode('playstore'));

      // Tab button events
      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.getAttribute('data-index') || '0', 10);
          setScreen(index);
        });
      });

      // Thumbnail events
      thumbnailCards.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const index = parseInt(thumb.getAttribute('data-thumbnail-index') || '0', 10);
          setScreen(index);
        });
      });

      // Arrow navigation
      if (prevBtn) prevBtn.addEventListener('click', () => setScreen(activeIndex - 1, 'backward'));
      if (nextBtn) nextBtn.addEventListener('click', () => setScreen(activeIndex + 1, 'forward'));

      // Keyboard arrow navigation
      document.addEventListener('keydown', (e) => {
        if (lightbox && lightbox.open) return;
        if (e.key === 'ArrowLeft') {
          setScreen(activeIndex - 1, 'backward');
        } else if (e.key === 'ArrowRight') {
          setScreen(activeIndex + 1, 'forward');
        }
      });

      // Touch swipe gestures on phone trigger
      if (phoneTrigger) {
        let touchStartX = 0;
        let touchStartY = 0;
        let touchEndX = 0;
        let touchEndY = 0;

        phoneTrigger.addEventListener(
          'touchstart',
          (e) => {
            touchStartX = e.changedTouches[0].screenX;
            touchStartY = e.changedTouches[0].screenY;
          },
          { passive: true }
        );

        phoneTrigger.addEventListener(
          'touchend',
          (e) => {
            touchEndX = e.changedTouches[0].screenX;
            touchEndY = e.changedTouches[0].screenY;
            const diffX = touchEndX - touchStartX;
            const diffY = touchEndY - touchStartY;
            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
              if (diffX < 0) {
                setScreen(activeIndex + 1, 'forward');
              } else {
                setScreen(activeIndex - 1, 'backward');
              }
            }
          },
          { passive: true }
        );
      }

      // Lightbox functionality
      if (phoneTrigger && lightbox && lightboxImg) {
        phoneTrigger.addEventListener('click', () => {
          const currentData = screens[activeIndex];
          lightboxImg.src = getActiveImageUrl(activeIndex);
          lightboxImg.alt = currentData ? currentData.title : 'TextMorph Screenshot';
          if (lightboxTitle && currentData) {
            lightboxTitle.textContent = `${currentData.num} · ${currentData.title}`;
          }
          lightbox.showModal();
        });
      }

      if (lightboxCloseBtn && lightbox) {
        lightboxCloseBtn.addEventListener('click', () => lightbox.close());
      }

      if (lightbox) {
        lightbox.addEventListener('click', (e) => {
          const rect = lightbox.getBoundingClientRect();
          const isInDialog =
            rect.top <= e.clientY &&
            e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX &&
            e.clientX <= rect.left + rect.width;
          if (!isInDialog) {
            lightbox.close();
          }
        });
      }

      updateMobileIndicator();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAppShowcase);
    } else {
      initAppShowcase();
    }
  </script>
</Layout>
