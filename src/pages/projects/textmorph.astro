---
// src/pages/projects/textmorph.astro
// Dedicated flagship showcase page for TextMorph Android project.
// Features: 3D Forest Clay app icon, direct APK download, Google Play Store marketing visual showcase, architecture deep-dive.

import Layout from '../../layouts/Layout.astro';
import ScreenshotsShowcase from '../../components/textmorph/ScreenshotsShowcase.astro';
import Architecture from '../../components/textmorph/Architecture.astro';

// Authoritative repository endpoints & release info
const REPO_URL = 'https://github.com/faycalrafa/TextMorph';
const APP_ICON_URL = '/images/logos/icons/textmorph.png';

// Baseline fallback constants
const FALLBACK_VERSION = 'v1.0.0';
const FALLBACK_APK_URL = 'https://github.com/faycalrafa/TextMorph/releases';
const FALLBACK_RELEASE_URL = 'https://github.com/faycalrafa/TextMorph/releases';

// Dynamic build-time release info fetched from GitHub API
let releaseInfo = {
  version: FALLBACK_VERSION,
  apkUrl: FALLBACK_APK_URL,
  releaseUrl: FALLBACK_RELEASE_URL,
  sizeMb: '~45.2 MB',
  publishedDate: 'Oct 20, 2026',
  releaseName: 'TextMorph v1.0.0 (Stable)'
};

try {
  const res = await fetch('https://api.github.com/repos/faycalrafa/TextMorph/releases/latest', {
    headers: { 'Accept': 'application/vnd.github.v3+json', 'User-Agent': 'FaycalRafa-Portfolio' },
    signal: AbortSignal.timeout(3500)
  });
  if (res.ok) {
    const data = await res.json();
    const apkAsset = data.assets?.find((a: any) => a.name.endsWith('.apk'));
    if (apkAsset && data.tag_name) {
      const sizeInMb = (apkAsset.size / (1024 * 1024)).toFixed(1);
      const pubDate = new Date(data.published_at).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });
      releaseInfo = {
        version: data.tag_name,
        apkUrl: apkAsset.browser_download_url,
        releaseUrl: data.html_url || `https://github.com/faycalrafa/TextMorph/releases/tag/${data.tag_name}`,
        sizeMb: `~${sizeInMb} MB`,
        publishedDate: pubDate,
        releaseName: data.name || `TextMorph ${data.tag_name} (Stable)`
      };
    }
  }
} catch {
  // Graceful fallback to verified release
}
---

<Layout
  title="TextMorph | System-Wide On-Device AI Writing Assistant | Faycal Rafa"
  description="TextMorph is Faycal Rafa's privacy-first on-device multimodal AI writing assistant & floating toolbar for Android powered by a modular multi-engine local LLM architecture."
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- ═══════════════════ HERO ═══════════════════ -->
    <header class="mb-12">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
        <!-- App Icon -->
        <div class="shrink-0">
          <div class="relative h-28 w-28 sm:h-36 sm:w-36">
            <div class="absolute inset-0 rounded-[32%] bg-gradient-to-br from-slate-600 via-slate-700 to-zinc-900 opacity-25 blur-2xl scale-110"></div>
            <img
              src={APP_ICON_URL}
              alt="TextMorph app launcher icon"
              width="144"
              height="144"
              class="relative h-full w-full rounded-[32%] object-cover shadow-2xl shadow-slate-900/50 ring-4 ring-slate-600/30 bg-zinc-900 p-2"
              loading="eager"
              fetchpriority="high"
              onerror="this.style.display='none';document.getElementById('icon-fallback').style.display='flex'"
            />
            <div id="icon-fallback" class="relative hidden h-full w-full rounded-[32%] bg-gradient-to-br from-slate-700 to-zinc-900 items-center justify-center shadow-2xl">
              <span class="text-3xl font-black text-white font-mono">TM</span>
            </div>
          </div>
        </div>

        <!-- Hero Content -->
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-500/30 bg-slate-800/10 px-3 py-1 text-xs font-semibold text-slate-800 dark:border-slate-400/30 dark:bg-slate-800/60 dark:text-slate-200 ring-1 ring-slate-500/20">
              <span class="h-1.5 w-1.5 rounded-full bg-slate-500 dark:bg-slate-400 animate-pulse" aria-hidden="true"></span>
              <span data-i18n="common.badges.open_source">Open Source</span>
              <span class="sr-only">Flagship Project</span>
            </span>
            <span
              id="textmorph-version-badge"
              class="inline-flex items-center gap-1.5 rounded-full border border-slate-400/30 bg-slate-400/10 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:border-slate-500/30 dark:bg-slate-800/50 dark:text-slate-300 ltr-isolate"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-slate-500 dark:bg-slate-400" aria-hidden="true"></span>
              <span id="textmorph-version-text">{releaseInfo.version} · Latest</span>
            </span>
            <span class="inline-flex items-center gap-1 rounded-full border border-zinc-200 bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 ltr-isolate">
              Android · Kotlin · Multi-Engine LLM · LiteRT-LM
            </span>
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl md:text-5xl dark:text-zinc-50">
            TextMorph
          </h1>
          <p class="mt-3 text-base sm:text-lg leading-relaxed text-zinc-600 dark:text-zinc-300 max-w-2xl" data-i18n="textmorph.hero_description">
            A system-wide, privacy-first multimodal AI writing assistant & floating toolbar for Android. Powered by a modular multi-engine architecture capable of executing any open foundation LLM locally with zero-copy memory mapping, slash commands, and an embedded OpenAI server.
          </p>

          <!-- Download CTAs -->
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a
              id="textmorph-download-apk"
              href={releaseInfo.apkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-slate-900 via-slate-800 to-zinc-900 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/30 hover:from-slate-800 hover:to-slate-700 dark:from-slate-100 dark:via-slate-200 dark:to-white dark:text-slate-950 dark:hover:from-white dark:hover:to-slate-100 transition-all hover:scale-[1.02] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-700"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span data-i18n="common.actions.releases_apk">Download Releases / APK</span>
              <span id="textmorph-apk-size" class="text-slate-300 dark:text-slate-600 font-normal text-xs">{releaseInfo.sizeMb}</span>
            </a>

            <a
              href={REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-700 shadow-xs hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-700"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span data-i18n="common.actions.github_repo">GitHub Repo</span>
            </a>

            <a
              id="textmorph-release-notes"
              href={releaseInfo.releaseUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-zinc-500 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-300 transition-colors underline underline-offset-2"
            >
              {releaseInfo.version} Release Notes →
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══════════════════ PLAY STORE SCREENSHOTS SHOWCASE ═══════════════════ -->
    <ScreenshotsShowcase />

    <!-- ═══════════════════ FEATURES GRID ═══════════════════ -->
    <section class="mb-14" aria-labelledby="features-heading">
      <h2 id="features-heading" class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mb-6" data-i18n="textmorph.features_heading">Key Features</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { emoji: '🤖', title: 'Multi-Engine On-Device AI', desc: 'Modular multi-engine inference runtime (Google LiteRT-LM and native engines) capable of executing any open foundation LLM directly on mobile silicon with hardware GPU/NPU acceleration and total privacy.' },
          { emoji: '🎯', title: 'System-Wide Floating AI Pill', desc: 'Non-intrusive AccessibilityService overlay that anchors above active input fields without stealing keyboard focus (FLAG_NOT_FOCUSABLE).' },
          { emoji: '⚡', title: 'Zero-Copy Downloads Loader', desc: 'Directly memory-maps multi-gigabyte .litertlm model files via Linux mmap and ParcelFileDescriptor with zero duplicate flash storage overhead.' },
          { emoji: '⌨️', title: 'Universal Slash Commands', desc: 'Trigger AI transformations in any text box by typing /fix, /summarize, /fr (French), or /ar (Arabic) with instant in-place buffer replacement.' },
          { emoji: '🌐', title: 'Embedded Localhost OpenAI Server', desc: 'Lightweight Ktor CIO HTTP server on 127.0.0.1:8080 exposing standard OpenAI-compatible streaming chat completions for Termux and local tools.' },
          { emoji: '👁️', title: 'Multimodal Vision Screen Assist', desc: 'MediaProjection integration captures active screen context and provides instant on-device multimodal reasoning and answers without cloud exposure.' },
          { emoji: '📋', title: 'Direct Companion Actions', desc: 'Top 5 customizable prompt actions accessible with a single tap in the floating companion bar. Drag-and-drop reordering with persistent Room DB.' },
          { emoji: '✂️', title: 'Zero-Permission Action Menu', desc: 'Registers directly as an Android ACTION_PROCESS_TEXT context menu provider for highlight-and-transform operations in any browser or app.' },
          { emoji: '🌿', title: 'Charcoal & Slate Modern Material Design', desc: 'Bespoke aesthetic balancing deep charcoal slate tones with high-contrast neutral accents and adaptive full-width dialog properties.' },
        ].map(({ emoji, title, desc }) => (
          <div class="rounded-xl border border-zinc-200/80 bg-white p-5 shadow-xs dark:border-zinc-800 dark:bg-zinc-900/60 hover:border-slate-400/60 dark:hover:border-slate-500/60 transition-colors">
            <div class="text-2xl mb-3">{emoji}</div>
            <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 mb-1.5">{title}</h3>
            <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════ ARCHITECTURE ═══════════════════ -->
    <Architecture />

    <!-- ═══════════════════ TECH STACK PILLS ═══════════════════ -->
    <section class="mb-12" aria-label="Technology stack">
      <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 mb-4" data-i18n="textmorph.tech_stack_heading">Tech Stack</h2>
      <div class="flex flex-wrap gap-2">
        {['Android Kotlin', 'Jetpack Compose M3', 'Multi-Engine LLM', 'Google LiteRT-LM', 'llama.cpp (GGUF)', 'OpenAI-Compatible APIs', 'AccessibilityService', 'Ktor CIO Server', 'Linux mmap', 'ParcelFileDescriptor', 'WindowManager Overlay', 'Kotlin Coroutines', 'StateFlow', 'Room DB'].map(tech => (
          <span class="inline-flex items-center rounded-lg border border-zinc-200/90 bg-zinc-100/80 px-2.5 py-1 font-mono text-xs font-medium text-zinc-800 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-zinc-200">
            {tech}
          </span>
        ))}
      </div>
    </section>

    <!-- ═══════════════════ FOOTER LINKS ═══════════════════ -->
    <footer class="flex flex-wrap items-center justify-between gap-4 border-t border-zinc-200/80 pt-8 dark:border-zinc-800/80">
      <a href="/projects" class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
        <svg class="h-4 w-4 arrow-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" /></svg>
        <span data-i18n="common.actions.back_to_projects">All Projects</span>
      </a>
      <div class="flex items-center gap-4">
        <a href="/projects/bookreader" class="inline-flex items-center gap-1.5 text-sm font-semibold text-amber-600 hover:text-amber-700 dark:text-amber-400 dark:hover:text-amber-300 transition-colors">
          <span data-i18n="projects.open_bookreader_showcase">BookReader Showcase →</span>
        </a>
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-500 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-100 transition-colors">
          <span data-i18n="common.actions.github_repo">GitHub Repo</span>
          <span class="arrow-icon">→</span>
        </a>
      </div>
    </footer>
  </div>

  <!-- ═══════════════════ SHOWCASE CLIENT CONTROLLER ═══════════════════ -->
  <script>
    import { initAppShowcase } from "../../scripts/textmorph-showcase";
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAppShowcase);
    } else {
      initAppShowcase();
    }
  </script>
</Layout>
