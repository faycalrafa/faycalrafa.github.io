    <!-- ═══════════════════ TECH STACK PILLS ═══════════════════ -->
    <section class="mb-12" aria-label="Technology stack">
      <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 mb-4">Tech Stack</h2>
