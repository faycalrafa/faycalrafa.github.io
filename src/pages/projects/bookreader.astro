            <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="p-2 max-h-[82vh] overflow-auto flex justify-center">
        <img
          id="lightbox-img"
          src={APP_SCREENS[0].image}
