                <div class="aspect-[460/1024] w-full rounded-lg overflow-hidden bg-black mb-2 shadow-xs">
                  <img
                    src={screen.image}
                    alt={screen.title}
                    class="h-full w-full object-cover transition-transform group-hover:scale-105"
