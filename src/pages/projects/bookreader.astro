      closedby="any"
      aria-label="Screenshot Fullscreen View"
      class="m-auto rounded-3xl border border-zinc-700 bg-zinc-950/95 p-4 shadow-2xl backdrop:bg-black/85 backdrop:backdrop-blur-md max-w-lg open:flex open:flex-col items-center transition-all"
    >
