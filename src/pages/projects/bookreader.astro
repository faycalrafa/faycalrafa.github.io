---
// src/pages/projects/bookreader.astro
// Dedicated flagship showcase page for BookReader Android hobby project.
// Features: 3D app icon, direct APK download, authentic Android app screenshots showcase, architecture deep-dive.

import Layout from '../../layouts/Layout.astro';

const APK_URL = 'https://github.com/faycalrafa/free-novel-reader-tts-android/releases/download/v3.4.0/app-release.apk';
const UPDATE_APK_URL = 'https://github.com/faycalrafa/free-novel-reader-tts-android/releases/download/v3.4.0/update-latest.apk';
const REPO_URL = 'https://github.com/faycalrafa/free-novel-reader-tts-android';
const RELEASE_URL = 'https://github.com/faycalrafa/free-novel-reader-tts-android/releases/tag/v3.4.0';
const APP_ICON_URL = 'https://raw.githubusercontent.com/faycalrafa/free-novel-reader-tts-android/main/android-app/app/src/main/res/mipmap-xxxhdpi/ic_launcher.webp';

const APP_SCREENS = [
  {
    id: 'home',
    num: '01',
    title: 'Library & Playlist Hub',
    subtitle: 'NovelArrow Reader Pro · Root Folder & Scoped Storage',
    tag: 'Storage & Playlists',
    image: '/images/bookreader/screenshot-01-home.jpg',
    description: 'Pick any root folder on your Android device. Every subfolder automatically becomes its own reading playlist with independently tracked chapter progression and offline text-to-speech audio state.',
    highlights: [
      'Automatic subfolder playlist indexing via Android Storage Access Framework',
      'Crash-proof chapter progress saving using AtomicFile',
      'Instant one-tap Resume directly from the home deck',
      'Offline-first architecture with zero mandatory network connectivity'
    ],
    tech: 'Kotlin Coroutines · AndroidX DocumentFile · AtomicFiles'
  },
  {
    id: 'voice-engine',
    num: '02',
    title: 'Neural Voice Engine',
    subtitle: 'On-Device AI Voices · Kokoro, Piper & KittenTTS',
    tag: 'Speech Synthesis & AI',
    image: '/images/bookreader/screenshot-02-voice-engines.jpg',
    description: 'Switch effortlessly between Android built-in Google TTS (474 voices) and cutting-edge on-device neural voice bundles. Experience natural human-grade prosody without any cloud subscriptions or privacy exposure.',
    highlights: [
      'Kokoro TTS: State-of-the-art 82M open-weight neural model (88MB) delivering human-grade prosody',
      'Piper TTS: Ultra-fast neural voice engine with English, French, and Arabic voices (<65MB each)',
      'KittenTTS: Ultra-compact embedded on-device models (<30MB) for minimal battery drain',
      'Standard window.speechSynthesis and native Android TextToSpeech fallbacks'
    ],
    tech: 'On-Device Neural TTS · Piper C++ · Kokoro 82M · Android TextToSpeech'
  },
  {
    id: 'toolbar-settings',
    num: '03',
    title: 'Persistent Notification Media Bar',
    subtitle: 'AndroidX Media3 Foreground Service & Quick Controls',
    tag: 'Background Audio',
    image: '/images/bookreader/screenshot-03-toolbar-settings.jpg',
    description: 'A customized, quick-access reader bar pinned directly in your Android notification shade and lock screen. Keeps playback alive even after closing the app with battery optimization unrestricted.',
    highlights: [
      'Live notification bar preview showing chapter progress, rate (1.25x), and sleep timer',
      'One-tap button toggles: reading speed cycling, sleep timer presets (15m, 30m, 1h)',
      'Previous/Next chapter jumping and live web chapter sync directly from notification',
      'Persistent foreground service surviving aggressive OS background task killers'
    ],
    tech: 'AndroidX Media3 · MediaSessionService · Foreground Service'
  },
  {
    id: 'audio-studio',
    num: '04',
    title: 'Audio Studio & Audiobook Generator',
    subtitle: 'Offline Chapter Synthesis & Standalone MP3 Tracks',
    tag: 'Audio Generation',
    image: '/images/bookreader/screenshot-04-audio-studio.jpg',
    description: 'Transform full web novel chapters into standalone MP3 audiobooks stored in local audio folders. Listen with the integrated chapter seekbar, speed adjustments (0.5×–2.5×), and background progress tracking.',
    highlights: [
      'Batch synthesis of novel text into clean MP3 audio files with track size tracking',
      'Built-in playback deck with chapter scrub bar, audio speed modifier, and sleep timer',
      'Organized folder playlists for continuous multi-chapter listening',
      'Full background audio focus management for incoming calls and notifications'
    ],
    tech: 'Background Synthesis Worker · MediaCodec · ExoPlayer'
  },
  {
    id: 'live-web-tts',
    num: '05',
    title: 'Live Web TTS & Reader',
    subtitle: 'In-App Web Scraper & Article Audio Player',
    tag: 'Web Scraping',
    image: '/images/bookreader/screenshot-05-live-web-tts.jpg',
    description: 'Integrated in-app browser with Jsoup DOM pipeline that strips ads, banners, and clutter from online novels and news sites. Streams clean extracted text straight into the live TTS audio player overlay.',
    highlights: [
      'Real-time content extraction with custom CSS selector filters',
      'Live Web TTS audio player dock with chapter progress (e.g. 15/49 chunks, 30%)',
      'Instant rate switching (1.75×) and chapter pagination buttons',
      'Clean typography reading mode optimized for sepia and dark OLED screens'
    ],
    tech: 'Jsoup HTML Parser · WebKit WebView · Reactive Live Chunker'
  }
];
---

<Layout
  title="BookReader — Android Novel Reader | Faycal Rafa"
  description="BookReader is Faycal Rafa's flagship Android hobby project: a high-performance novel reader with smart TTS, quote-aware sentence chunking, AndroidX Media3, and Jetpack Compose M3."
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
        <li>
          <a href="/" class="flex items-center gap-1.5 rounded transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">
            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9.5L10 3l7 6.5" /><path d="M19 13v6a1 1 0 01-1 1H2a1 1 0 01-1-1v-6" />
            </svg>
            <span>Home</span>
          </a>
        </li>
        <li class="text-zinc-400 dark:text-zinc-600" aria-hidden="true">
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
        </li>
        <li>
          <a href="/projects" class="rounded transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">Projects</a>
        </li>
        <li class="text-zinc-400 dark:text-zinc-600" aria-hidden="true">
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
        </li>
        <li class="font-medium text-zinc-900 dark:text-zinc-100" aria-current="page">BookReader</li>
      </ol>
    </nav>

    <!-- ═══════════════════ HERO ═══════════════════ -->
    <header class="mb-12">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
        <!-- App Icon -->
        <div class="shrink-0">
          <div class="relative h-28 w-28 sm:h-36 sm:w-36">
            <div class="absolute inset-0 rounded-[32%] bg-gradient-to-br from-amber-400 via-orange-500 to-red-600 opacity-20 blur-2xl scale-110"></div>
            <img
              src={APP_ICON_URL}
              alt="BookReader app launcher icon"
              width="144"
              height="144"
              class="relative h-full w-full rounded-[32%] object-cover shadow-2xl shadow-amber-600/30 ring-4 ring-amber-500/20"
              loading="eager"
              fetchpriority="high"
              onerror="this.style.display='none';document.getElementById('icon-fallback').style.display='flex'"
            />
            <div id="icon-fallback" class="relative hidden h-full w-full rounded-[32%] bg-gradient-to-br from-amber-500 to-orange-600 items-center justify-center shadow-2xl">
              <svg class="h-16 w-16 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 2H6c-1.206 0-3 .799-3 3v14c0 2.201 1.794 3 3 3h15v-2H6.012C5.55 19.988 5 19.806 5 19s.55-.988 1.012-1H21V4c0-1.103-.897-2-2-2zm0 14H5V5c0-.806.55-.988 1-1h13v12z"/>
                <path d="M9 7h6v2H9zm0 4h6v2H9z"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Hero Content -->
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-700 dark:border-amber-400/30 dark:bg-amber-400/15 dark:text-amber-300 ring-1 ring-amber-500/20">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse" aria-hidden="true"></span>
              Hobby Project
            </span>
            <span class="inline-flex items-center gap-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:border-emerald-400/30 dark:bg-emerald-400/15 dark:text-emerald-300">
              v3.4.0 · Latest
            </span>
            <span class="inline-flex items-center gap-1 rounded-full border border-zinc-200 bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400">
              Android · Kotlin · Jetpack Compose
            </span>
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl md:text-5xl dark:text-zinc-50">
            BookReader
          </h1>
          <p class="mt-3 text-base sm:text-lg leading-relaxed text-zinc-600 dark:text-zinc-300 max-w-2xl">
            My ongoing Android hobby project — a high-performance native novel reader with on-device neural TTS audio, quote-aware sentence chunking, persistent notification media bar, and offline audiobook synthesis.
          </p>

          <!-- Download CTAs -->
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a
              href={APK_URL}
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-amber-600 to-orange-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-amber-600/25 hover:from-amber-500 hover:to-orange-500 dark:from-amber-500 dark:to-orange-500 dark:hover:from-amber-400 dark:hover:to-orange-400 transition-all hover:scale-[1.02] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
              download="BookReader-v3.4.0.apk"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span>Download APK</span>
              <span class="text-amber-200 font-normal text-xs">~20 MB</span>
            </a>

            <!-- Secondary Download Dropdown -->
            <details class="relative inline-block" id="dropdown-downloads">
              <summary
                id="dropdown-apk"
                aria-haspopup="true"
                class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-700 shadow-xs hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                </svg>
                <span>Other Downloads</span>
                <svg class="h-3.5 w-3.5 text-zinc-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="absolute left-0 mt-2 w-64 rounded-xl border border-zinc-200 bg-white p-2 shadow-xl dark:border-zinc-700 dark:bg-zinc-900 z-20">
                <a
                  href={UPDATE_APK_URL}
                  class="flex items-center justify-between rounded-lg px-3 py-2 text-xs font-semibold text-zinc-800 hover:bg-zinc-100 dark:text-zinc-200 dark:hover:bg-zinc-800 transition-colors"
                  download="BookReader-update-latest.apk"
                >
                  <span class="flex items-center gap-2">
                    <svg class="h-3.5 w-3.5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                    <span>Update APK (Patch)</span>
                  </span>
                  <span class="text-zinc-400 font-mono text-[10px]">update-latest.apk</span>
                </a>
              </div>
            </details>

            <a
              href={REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-700 shadow-xs hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>GitHub Repo</span>
            </a>

            <a
              href={RELEASE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-zinc-500 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-300 transition-colors underline underline-offset-2"
            >
              Release Notes →
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══════════════════ ANDROID APP SCREENSHOTS SHOWCASE ═══════════════════ -->
    <section class="mb-16" aria-labelledby="showcase-heading">
      <div class="rounded-3xl border-2 border-amber-500/25 bg-gradient-to-br from-amber-50/70 via-orange-50/40 to-zinc-50 dark:from-amber-950/25 dark:via-orange-950/15 dark:to-zinc-900 dark:border-amber-400/20 overflow-hidden shadow-xl p-6 sm:p-8">
        
        <!-- Showcase Header -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-amber-500/20 dark:border-amber-400/15">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="inline-flex items-center gap-1.5 rounded-md bg-amber-500/15 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300 ring-1 ring-amber-500/20">
                <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
                Live Android Showcase
              </span>
              <span class="text-xs text-zinc-500 dark:text-zinc-400">5 Authentic Screens</span>
            </div>
            <h2 id="showcase-heading" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
              Native Android Experience
            </h2>
            <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 mt-1 max-w-2xl">
              Explore BookReader's custom Jetpack Compose interface in its signature sepia reading theme, on-device neural TTS voice engines, and persistent background playback.
            </p>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs text-zinc-400 dark:text-zinc-500 hidden md:inline">Click screen to expand</span>
          </div>
        </div>

        <!-- Screen Selector Tabs -->
        <div class="pt-6 pb-8">
          <div class="flex flex-wrap gap-2 sm:gap-2.5" role="tablist" aria-label="BookReader App Screens">
            {APP_SCREENS.map((screen, idx) => (
              <button
                type="button"
                role="tab"
                id={`tab-btn-${idx}`}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`panel-screen-${idx}`}
                data-index={idx}
                class:list={[
                  'screen-tab-btn inline-flex items-center gap-2 rounded-xl px-3.5 py-2 text-xs sm:text-sm font-semibold transition-all cursor-pointer select-none',
                  idx === 0
                    ? 'bg-amber-600 text-white shadow-md shadow-amber-600/30 ring-2 ring-amber-500/50'
                    : 'bg-white text-zinc-700 hover:bg-amber-50/80 border border-zinc-200 dark:bg-zinc-800/80 dark:text-zinc-300 dark:border-zinc-700 dark:hover:bg-zinc-800'
                ]}
              >
                <span class="text-[11px] font-mono opacity-80">{screen.num}</span>
                <span>{screen.title}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Featured Showcase Stage (Phone Mockup + Feature Deep-Dive) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
          
          <!-- Left: Realistic Android Smartphone Mockup Frame -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="relative w-[280px] sm:w-[310px]">
              <!-- Phone Chassis Silhouette -->
              <div class="relative rounded-[2.8rem] p-3 bg-gradient-to-b from-zinc-800 via-zinc-900 to-black shadow-2xl ring-1 ring-white/10 shadow-amber-950/30">
                <!-- Top Ear Speaker & Ambient Sensor -->
                <div class="absolute top-4 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20">
                  <div class="h-1 w-10 rounded-full bg-zinc-700/80"></div>
                  <div class="h-2 w-2 rounded-full bg-zinc-800 ring-1 ring-zinc-700"></div>
                </div>

                <!-- Screen Viewport with Click-to-Enlarge Action -->
                <div
                  id="phone-screen-trigger"
                  class="relative aspect-[460/1024] w-full overflow-hidden rounded-[2.1rem] bg-black shadow-inner cursor-zoom-in group"
                  title="Click to view high-resolution screenshot"
                >
                  <img
                    id="mockup-screen-img"
                    src={APP_SCREENS[0].image}
                    alt={APP_SCREENS[0].title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="eager"
                  />
                  <!-- Hover Hint Pill -->
                  <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-black/75 px-3 py-1.5 text-xs font-semibold text-white backdrop-blur-xs shadow-lg">
                      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line>
                      </svg>
                      View Fullscreen
                    </span>
                  </div>
                </div>

                <!-- Bottom Android Home Indicator Line -->
                <div class="mt-2 flex justify-center">
                  <div class="h-1 w-24 rounded-full bg-zinc-700/60"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Contextual Screen Description & Technical Architecture -->
          <div class="lg:col-span-7 flex flex-col justify-center">
            <div class="flex items-center gap-2 mb-2">
              <span id="detail-tag" class="inline-flex items-center rounded-full bg-amber-500/15 border border-amber-500/25 px-2.5 py-0.5 text-xs font-semibold text-amber-800 dark:text-amber-300">
                {APP_SCREENS[0].tag}
              </span>
              <span id="detail-num" class="text-xs font-mono text-zinc-400">
                Screen {APP_SCREENS[0].num} / 05
              </span>
            </div>

            <h3 id="detail-title" class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-zinc-50">
              {APP_SCREENS[0].title}
            </h3>
            <p id="detail-subtitle" class="text-sm font-semibold text-amber-700 dark:text-amber-400 mt-1">
              {APP_SCREENS[0].subtitle}
            </p>

            <p id="detail-desc" class="mt-4 text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-300">
              {APP_SCREENS[0].description}
            </p>

            <!-- Highlights Checklist -->
            <div class="mt-6 space-y-2.5">
              <p class="text-xs font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Key Capabilities</p>
              <ul id="detail-highlights" class="space-y-2 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
                {APP_SCREENS[0].highlights.map(h => (
                  <li class="flex items-start gap-2.5">
                    <svg class="h-4 w-4 shrink-0 text-amber-500 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                    </svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Tech Badge -->
            <div class="mt-6 pt-5 border-t border-amber-500/20 dark:border-amber-400/15 flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <span class="text-xs text-zinc-500 dark:text-zinc-400">Architecture:</span>
                <code id="detail-tech" class="rounded bg-amber-500/10 px-2 py-0.5 font-mono text-xs font-bold text-amber-800 dark:text-amber-300">
                  {APP_SCREENS[0].tech}
                </code>
              </div>

              <!-- Previous / Next screen buttons -->
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="btn-prev-screen"
                  class="inline-flex items-center justify-center h-8 w-8 rounded-lg border border-zinc-200 bg-white text-zinc-600 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 cursor-pointer transition-colors"
                  aria-label="Previous screenshot"
                >
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" /></svg>
                </button>
                <button
                  type="button"
                  id="btn-next-screen"
                  class="inline-flex items-center justify-center h-8 w-8 rounded-lg border border-zinc-200 bg-white text-zinc-600 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 cursor-pointer transition-colors"
                  aria-label="Next screenshot"
                >
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Thumbnail Strip Preview -->
        <div class="mt-12 pt-6 border-t border-amber-500/20 dark:border-amber-400/15">
          <p class="text-xs font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-3">All Screen Captures</p>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
            {APP_SCREENS.map((screen, idx) => (
              <button
                type="button"
                data-thumbnail-index={idx}
                class:list={[
                  'thumbnail-card group relative rounded-xl border p-2 text-left transition-all cursor-pointer',
                  idx === 0
                    ? 'border-amber-500 bg-amber-500/10 ring-2 ring-amber-500/30'
