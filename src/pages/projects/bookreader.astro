  <!-- ═══════════════════ TTS SIMULATOR SCRIPT ═══════════════════ -->
  <script>
    // ─── TypeScript Quote-Aware Sentence Chunker ───────────────────────────────
    // Mirrors BookReader's production Kotlin chunker algorithm.

    const PRESETS: Record<string, string> = {
      english: `"Stop!" she cried, rushing toward the door. "You can't leave now, not when we're so close to the truth!"
He paused, one hand on the doorknob. The rain hammered the windows like Mr. Harrison's old typewriter — relentless, rhythmic, unforgiving.
"Perhaps," he said quietly, "that's exactly why I must." He stepped out into the storm. Chapter 1 had just ended.`,
      arabic: `قالت المرأة العجوز: "لا تذهب بعيداً يا بني، فالطريق وعرة!" لكنه لم يسمع كلامها.
كان القمر يضيء الطريق المظلم. توقف الشاب وأخذ نفساً عميقاً ثم قرر المضي قدماً.
"أنا لست خائفاً." تمتم لنفسه. "سأعود بالكنز أو لن أعود أبداً!"`,
      french: `« Impossible ! » s'écria-t-elle. « Vous ne pouvez pas faire ça — pas maintenant ! »
Le Docteur Bernard posa son stylo. Il avait passé vingt ans à étudier ce phénomène, à publier des articles dans des revues scientifiques réputées. Et pourtant…
« Les données ne mentent pas, Professeure Morel. » Il se leva lentement. « La réponse était là depuis le début. »`,
      cjk: `「待って！」彼女は叫んだ。「まだ終わっていないのに、どこへ行くの？」
彼は振り返らなかった。雨が窓ガラスを叩いていた。静かな夜だった。
「もう決めたんだ。」彼は囁いた。「後悔はしない。絶対に！」`,
    };

    // Regex-based sentence chunker (quote-aware, multilingual)
    function chunkText(text: string): string[] {
      if (!text.trim()) return [];

      const chunks: string[] = [];
      let i = 0;
      const s = text.trim();

      // Tokenize by sentence boundaries while respecting quoted speech
      const OPEN_QUOTES = new Set(['"', '«', '\u201C', '\u300C', '\u300E']);
      const CLOSE_QUOTES: Record<string, string> = {
        '"': '"', '«': '»', '\u201C': '\u201D', '\u300C': '\u300D', '\u300E': '\u300F',
      };
      const SENTENCE_TERMINATORS = /[.!?。！？؟]/;
      const ABBREVIATIONS = /\b(Mr|Mrs|Ms|Dr|Prof|Sr|Jr|Inc|Ltd|Ch|vol|vs|etc|e\.g|i\.e|Fig|St|Blvd|Ave)\s*$/i;

      let current = '';
      let quoteOpen = false;
      let openQuoteChar = '';

      while (i < s.length) {
        const ch = s[i];

        // Track open quotes
        if (!quoteOpen && OPEN_QUOTES.has(ch)) {
          quoteOpen = true;
          openQuoteChar = ch;
          current += ch;
          i++;
          continue;
        }

        // Close quote
        if (quoteOpen && ch === CLOSE_QUOTES[openQuoteChar]) {
          quoteOpen = false;
          openQuoteChar = '';
          current += ch;
          i++;

          // After closing quote, check if sentence ends here
          const peek = s[i] || '';
          if (!peek.trim() || SENTENCE_TERMINATORS.test(peek)) {
            if (current.trim()) {
              // consume any trailing terminator after the closing quote
              if (SENTENCE_TERMINATORS.test(peek)) {
                current += peek;
                i++;
              }
              chunks.push(current.trim());
              current = '';
            }
          }
          continue;
        }

        // Inside a quote — consume without splitting
        if (quoteOpen) {
          current += ch;
          i++;
          continue;
        }

        // Check for sentence terminator
        if (SENTENCE_TERMINATORS.test(ch)) {
          current += ch;

          // Check for abbreviation — don't split
          if (ch === '.' && ABBREVIATIONS.test(current.slice(0, -1))) {
            i++;
            continue;
          }

          // Check for decimal number like 3.4 — don't split
          const prevChar = current[current.length - 2] || '';
          const nextChar = s[i + 1] || '';
          if (ch === '.' && /\d/.test(prevChar) && /\d/.test(nextChar)) {
            i++;
            continue;
          }

          // Consume trailing whitespace
          while (i + 1 < s.length && s[i + 1] === ' ') i++;

          if (current.trim()) {
            chunks.push(current.trim());
            current = '';
          }
          i++;
          continue;
        }

        // Newline = soft sentence break if current has content
        if (ch === '\n' && current.trim().length > 0) {
          // Only break if there's substantial content
          if (current.trim().length > 20) {
            chunks.push(current.trim());
            current = '';
          } else {
            current += ' ';
          }
          i++;
          continue;
        }

        current += ch;
        i++;
      }

      if (current.trim()) chunks.push(current.trim());
      return chunks.filter(c => c.length > 0);
    }

    // ─── DOM Elements ──────────────────────────────────────────────────────────
    const textarea = document.getElementById('tts-input') as HTMLTextAreaElement;
    const speedSelect = document.getElementById('tts-speed') as HTMLSelectElement;
    const voiceSelect = document.getElementById('tts-voice') as HTMLSelectElement;
    const btnChunk = document.getElementById('btn-chunk') as HTMLButtonElement;
    const btnPlay = document.getElementById('btn-play') as HTMLButtonElement;
    const btnStop = document.getElementById('btn-stop') as HTMLButtonElement;
    const chunksPanel = document.getElementById('chunks-panel') as HTMLDivElement;
    const chunksList = document.getElementById('chunks-list') as HTMLDivElement;
    const chunkCount = document.getElementById('chunk-count') as HTMLSpanElement;
    const statusDot = document.getElementById('sim-status-dot') as HTMLSpanElement;
    const statusText = document.getElementById('sim-status-text') as HTMLSpanElement;
    const statusBadge = document.getElementById('sim-status-badge') as HTMLDivElement;
    const noSpeechWarning = document.getElementById('no-speech-warning') as HTMLDivElement;
    const playIcon = document.getElementById('play-icon') as unknown as SVGElement;
    const playLabel = document.getElementById('play-btn-label') as HTMLSpanElement;

    // ─── State ─────────────────────────────────────────────────────────────────
    let chunks: string[] = [];
    let currentChunkIndex = 0;
    let isPlaying = false;
    const hasSpeech = 'speechSynthesis' in window;

    // ─── Speech API Setup ──────────────────────────────────────────────────────
    if (!hasSpeech) {
      noSpeechWarning.classList.remove('hidden');
    } else {
      // Populate voices
      function populateVoices() {
        const voices = window.speechSynthesis.getVoices();
        voiceSelect.innerHTML = '<option value="">Default Voice</option>';
        const filtered = voices.filter(v =>
          /en|ar|fr/i.test(v.lang)
        );
        filtered.forEach(v => {
          const opt = document.createElement('option');
          opt.value = v.name;
          opt.textContent = `${v.name} (${v.lang})`;
          voiceSelect.appendChild(opt);
        });
      }
      populateVoices();
      window.speechSynthesis.onvoiceschanged = populateVoices;
    }

    // ─── Status Helpers ────────────────────────────────────────────────────────
    function setStatus(label: string, color: 'idle' | 'playing' | 'ready' | 'error') {
      statusBadge.classList.remove('hidden');
      statusText.textContent = label;
      statusDot.className = 'h-2 w-2 rounded-full';
      if (color === 'playing') statusDot.classList.add('bg-amber-500', 'animate-pulse');
      else if (color === 'ready') statusDot.classList.add('bg-emerald-500');
      else if (color === 'error') statusDot.classList.add('bg-red-500');
      else statusDot.classList.add('bg-zinc-400');
    }

    // ─── Chunk Preview ─────────────────────────────────────────────────────────
    function renderChunks(highlightIndex = -1) {
      chunksList.innerHTML = '';
      chunks.forEach((chunk, i) => {
        const el = document.createElement('div');
        el.className = [
          'flex items-start gap-3 cursor-pointer rounded-lg px-3 py-2.5 text-sm leading-relaxed transition-colors',
          i === highlightIndex
            ? 'bg-amber-500/15 border border-amber-400/50 text-zinc-900 dark:text-zinc-100 dark:border-amber-500/40'
            : 'border border-transparent text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800/60',
        ].join(' ');
        el.setAttribute('role', 'listitem');
        el.setAttribute('aria-label', `Sentence ${i + 1}: ${chunk}`);
        el.innerHTML = `
          <span class="shrink-0 mt-0.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full text-xs font-bold ${
            i === highlightIndex
              ? 'bg-amber-500 text-white'
              : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400'
          }">${i + 1}</span>
          <span>${chunk}</span>
        `;
        el.addEventListener('click', () => {
          if (hasSpeech) {
            currentChunkIndex = i;
            startPlayback();
          }
        });
        chunksList.appendChild(el);
      });
    }

    btnChunk.addEventListener('click', () => {
      const text = textarea.value.trim();
      if (!text) return;
      chunks = chunkText(text);
      chunkCount.textContent = String(chunks.length);
      renderChunks();
      chunksPanel.classList.remove('hidden');
      btnPlay.disabled = chunks.length === 0 || !hasSpeech;
      setStatus(`${chunks.length} chunks ready`, 'ready');
      // Scroll to chunks panel
      chunksPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    // ─── Playback ──────────────────────────────────────────────────────────────
    function speakChunk(index: number) {
      if (!hasSpeech || index >= chunks.length) {
        stopPlayback();
        return;
      }
      currentChunkIndex = index;
      renderChunks(index);
      // Auto-scroll to active chunk
      const items = chunksList.querySelectorAll('[role="listitem"]');
      items[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      const utterance = new SpeechSynthesisUtterance(chunks[index]);
      utterance.rate = parseFloat(speedSelect.value);

      const voices = window.speechSynthesis.getVoices();
      const selectedVoice = voices.find(v => v.name === voiceSelect.value);
      if (selectedVoice) utterance.voice = selectedVoice;

      setStatus(`Speaking chunk ${index + 1} of ${chunks.length}`, 'playing');

      utterance.onend = () => {
        if (isPlaying && index + 1 < chunks.length) {
          setTimeout(() => speakChunk(index + 1), 120);
        } else if (index + 1 >= chunks.length) {
          stopPlayback();
          setStatus('Done ✓', 'ready');
        }
      };
      utterance.onerror = () => {
        stopPlayback();
        setStatus('Error', 'error');
      };

      window.speechSynthesis.cancel();
      window.speechSynthesis.speak(utterance);
    }

    function startPlayback() {
      if (!hasSpeech || chunks.length === 0) return;
      isPlaying = true;
      btnPlay.disabled = false;
      btnStop.disabled = false;
      playLabel.textContent = 'Pause';
      playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/>';
      speakChunk(currentChunkIndex);
    }

    function pausePlayback() {
      if (!hasSpeech) return;
      isPlaying = false;
      window.speechSynthesis.pause();
      playLabel.textContent = 'Resume';
      playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
      setStatus('Paused', 'idle');
    }

    function stopPlayback() {
      if (!hasSpeech) return;
      isPlaying = false;
      currentChunkIndex = 0;
      window.speechSynthesis.cancel();
      btnStop.disabled = true;
      playLabel.textContent = 'Play All';
      playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
      renderChunks();
      setStatus('Stopped', 'idle');
    }

    btnPlay.addEventListener('click', () => {
      if (isPlaying) pausePlayback();
      else {
        // If we just paused, resume; else start fresh
        if (window.speechSynthesis.paused) {
          isPlaying = true;
          window.speechSynthesis.resume();
          playLabel.textContent = 'Pause';
          playIcon.innerHTML = '<rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/>';
          setStatus(`Speaking chunk ${currentChunkIndex + 1} of ${chunks.length}`, 'playing');
        } else {
          currentChunkIndex = 0;
          startPlayback();
        }
      }
    });

    btnStop.addEventListener('click', stopPlayback);

    // ─── Preset Buttons ────────────────────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.preset ?? '';
        if (PRESETS[key]) {
          textarea.value = PRESETS[key];
          // Auto-chunk
          btnChunk.click();
        }
      });
    });

    // Stop on page navigation (View Transitions)
    document.addEventListener('astro:before-swap', () => {
      if (hasSpeech) window.speechSynthesis.cancel();
    });
  </script>
</Layout>
