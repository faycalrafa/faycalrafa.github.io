          class="max-h-[78vh] w-auto rounded-xl shadow-2xl object-contain"
        />
      </div>
    </dialog>

    <!-- ═══════════════════ FEATURES GRID ═══════════════════ -->
    <section class="mb-14" aria-labelledby="features-heading">
      <h2 id="features-heading" class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mb-6">Key Features</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { emoji: '🎙️', title: 'On-Device Neural Voices', desc: 'Kokoro TTS (82M prosody), Piper TTS (<65MB Arabic, French, and English), and KittenTTS (<30MB) running entirely on device with zero cloud latency.' },
          { emoji: '⏱️', title: 'Notification Shade Toolbar', desc: 'AndroidX Media3 foreground service keeping reading speed cycling (1.0x, 1.25x), sleep timers, and chapter skipping pinned to your notification bar.' },
          { emoji: '📥', title: 'Batch Chapter Audio Studio', desc: 'Automatically synthesizes novel text into standalone MP3 audio files with custom folder management, seekbar playback, and background worker.' },
          { emoji: '🌐', title: 'Live Web TTS & Scraper', desc: 'Multi-tab in-app browser with Jsoup DOM pipeline stripping ads and sidebars, streaming clean web novels directly into the speech synthesis engine.' },
          { emoji: '🔊', title: 'Background Audio Playback', desc: 'AndroidX Media3 MediaSessionService with full lock screen controls, earbud click triggers, and audio focus management for phone calls.' },
          { emoji: '🎨', title: 'Responsive Sepia UI', desc: 'Jetpack Compose Material 3 in warm sepia, dark OLED, and light modes. Clean typography, quote-aware sentence tokenizer, and custom speech rate.' },
          { emoji: '🧹', title: 'Content Filters & Replacement', desc: 'Header/footer skip keywords, HTML CSS selectors, word skip rules, and pronunciation phonetic replacements for clean reading.' },
          { emoji: '💾', title: 'Crash-Proof Scoped Storage', desc: 'AtomicFile writes for zero corruption on sudden OS kills. All reading playlists and chapter progress survive aggressive Android battery killers.' },
          { emoji: '🔧', title: 'Userscript Engine', desc: 'Modular script injection with wildcard URL pattern matching, custom DOM manipulation, and site-specific novel overrides.' },
        ].map(({ emoji, title, desc }) => (
          <div class="rounded-xl border border-zinc-200/80 bg-white p-5 shadow-xs dark:border-zinc-800 dark:bg-zinc-900/60 hover:border-amber-300/60 dark:hover:border-amber-600/40 transition-colors">
            <div class="text-2xl mb-3">{emoji}</div>
            <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 mb-1.5">{title}</h3>
            <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════ ARCHITECTURE ═══════════════════ -->
    <section class="mb-14" aria-labelledby="arch-heading">
      <h2 id="arch-heading" class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mb-6">Architecture & Technology</h2>
      <div class="overflow-hidden rounded-2xl border border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 shadow-xs">
        {[
          {
            layer: 'UI Layer',
            color: 'blue',
            tech: 'Jetpack Compose M3',
            desc: 'Fully declarative Kotlin UI with Material Design 3 theming. Signature sepia/dark/light themes, bottom dock media controls, and full-width adaptive dialogs for settings.',
          },
          {
            layer: 'Audio Engine',
            color: 'amber',
            tech: 'AndroidX Media3 + ExoPlayer',
            desc: 'Decoupled MediaSessionService operating in an independent Android Service lifecycle. Survives orientation changes, app minimization, and handles audio focus for calls and navigation prompts.',
          },
          {
            layer: 'TTS Processing',
            color: 'green',
            tech: 'Neural Engines (Kokoro / Piper) + Native TextToSpeech',
            desc: 'Multi-engine speech synthesis abstraction. Regex-based quote-aware tokenizer with quote protection (", «», ""), abbreviation shielding (Mr., Dr., Ch.), and CJK terminal character detection.',
          },
          {
            layer: 'Web Scraping',
            color: 'purple',
            tech: 'Jsoup + WebView',
            desc: 'Jsoup DOM pipeline for chapter extraction using user-configurable CSS selectors. JavascriptInterface bridge for userscript injection with wildcard URL matching.',
          },
          {
            layer: 'Storage',
            color: 'orange',
            tech: 'AtomicFile + Kotlin Coroutines',
            desc: 'Crash-resistant persistence via Android AtomicFile (write → staging file → atomic rename). Thread-safe access with Coroutine Mutexes. Zero special permissions required.',
          },
          {
            layer: 'Architecture Pattern',
            color: 'zinc',
            tech: 'Clean Architecture + MVVM',
            desc: 'Decoupled domain, data, and presentation layers. StateFlow-driven reactive UI state, centralized AudioPlaybackCoordinator service, and Coroutine-based async operations.',
          },
        ].map(({ layer, color, tech, desc }, i) => (
          <div class:list={['flex items-start gap-4 p-5', i > 0 && 'border-t border-zinc-100 dark:border-zinc-800']}>
            <div class:list={[
              'flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-xs font-bold mt-0.5',
              color === 'blue' && 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
              color === 'amber' && 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
