---
// src/pages/projects/bookreader.astro
// Dedicated flagship showcase page for BookReader Android hobby project.
// Features: 3D app icon, direct APK download, authentic Android app screenshots showcase, architecture deep-dive.

import Layout from '../../layouts/Layout.astro';
import ScreenshotsShowcase from '../../components/bookreader/ScreenshotsShowcase.astro';
import Architecture from '../../components/bookreader/Architecture.astro';

// Authoritative repository endpoints & fallback verified release
const REPO_URL = 'https://github.com/faycalrafa/free-novel-reader-tts-android';
const APP_ICON_URL = 'https://raw.githubusercontent.com/faycalrafa/free-novel-reader-tts-android/main/android-app/app/src/main/res/mipmap-xxxhdpi/ic_launcher.webp';

// Baseline fallback constants
const FALLBACK_VERSION = 'v3.5.4';
const FALLBACK_APK_URL = 'https://github.com/faycalrafa/free-novel-reader-tts-android/releases/download/v3.5.4/app-release.apk';
const FALLBACK_UPDATE_APK_URL = 'https://github.com/faycalrafa/free-novel-reader-tts-android/releases/download/v3.5.4/update-latest.apk';
const FALLBACK_RELEASE_URL = 'https://github.com/faycalrafa/free-novel-reader-tts-android/releases/tag/v3.5.4';

// Dynamic build-time release info fetched from GitHub API
let releaseInfo = {
  version: FALLBACK_VERSION,
  apkUrl: FALLBACK_APK_URL,
  updateApkUrl: FALLBACK_UPDATE_APK_URL,
  releaseUrl: FALLBACK_RELEASE_URL,
  sizeMb: '~20.1 MB',
  publishedDate: 'Oct 17, 2026',
  releaseName: 'BookReader v3.5.4 (Stable)'
};

try {
  const res = await fetch('https://api.github.com/repos/faycalrafa/free-novel-reader-tts-android/releases/latest', {
    headers: { 'Accept': 'application/vnd.github.v3+json', 'User-Agent': 'FaycalRafa-Portfolio' },
    signal: AbortSignal.timeout(3500)
  });
  if (res.ok) {
    const data = await res.json();
    const apkAsset = data.assets?.find((a: any) => a.name === 'app-release.apk');
    const updateAsset = data.assets?.find((a: any) => a.name === 'update-latest.apk');
    if (apkAsset && data.tag_name) {
      const sizeInMb = (apkAsset.size / (1024 * 1024)).toFixed(1);
      const pubDate = new Date(data.published_at).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      });
      releaseInfo = {
        version: data.tag_name,
        apkUrl: apkAsset.browser_download_url,
        updateApkUrl: updateAsset?.browser_download_url || apkAsset.browser_download_url,
        releaseUrl: data.html_url || `https://github.com/faycalrafa/free-novel-reader-tts-android/releases/tag/${data.tag_name}`,
        sizeMb: `~${sizeInMb} MB`,
        publishedDate: pubDate,
        releaseName: data.name || `BookReader ${data.tag_name} (Stable)`
      };
    }
  }
} catch {
  // Graceful fallback to verified release
}

---

<Layout
  title="BookReader | Android Novel Reader | Faycal Rafa"
  description="BookReader is Faycal Rafa's flagship Android hobby project: a high-performance novel reader with smart TTS, quote-aware sentence chunking, AndroidX Media3, and Jetpack Compose M3."
>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">

    <!-- ═══════════════════ HERO ═══════════════════ -->
    <header class="mb-12">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
        <!-- App Icon -->
        <div class="shrink-0">
          <div class="relative h-28 w-28 sm:h-36 sm:w-36">
            <div class="absolute inset-0 rounded-[32%] bg-gradient-to-br from-amber-400 via-orange-500 to-red-600 opacity-20 blur-2xl scale-110"></div>
            <img
              src={APP_ICON_URL}
              alt="BookReader app launcher icon"
              width="144"
              height="144"
              class="relative h-full w-full rounded-[32%] object-cover shadow-2xl shadow-amber-600/30 ring-4 ring-amber-500/20"
              loading="eager"
              fetchpriority="high"
              onerror="this.style.display='none';document.getElementById('icon-fallback').style.display='flex'"
            />
            <div id="icon-fallback" class="relative hidden h-full w-full rounded-[32%] bg-gradient-to-br from-amber-500 to-orange-600 items-center justify-center shadow-2xl">
              <svg class="h-16 w-16 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 2H6c-1.206 0-3 .799-3 3v14c0 2.201 1.794 3 3 3h15v-2H6.012C5.55 19.988 5 19.806 5 19s.55-.988 1.012-1H21V4c0-1.103-.897-2-2-2zm0 14H5V5c0-.806.55-.988 1-1h13v12z"/>
                <path d="M9 7h6v2H9zm0 4h6v2H9z"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- Hero Content -->
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-700 dark:border-amber-400/30 dark:bg-amber-400/15 dark:text-amber-300 ring-1 ring-amber-500/20">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse" aria-hidden="true"></span>
              <span data-i18n="common.badges.free_to_use">Free to Use</span>
              <span class="sr-only">Hobby Project</span>
            </span>
            <span
              id="bookreader-version-badge"
              class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:border-emerald-400/30 dark:bg-emerald-400/15 dark:text-emerald-300 ltr-isolate"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
              <span id="bookreader-version-text">{releaseInfo.version} · Latest</span>
            </span>
            <span class="inline-flex items-center gap-1 rounded-full border border-zinc-200 bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 ltr-isolate">
              Android · Kotlin · Jetpack Compose
            </span>
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl md:text-5xl dark:text-zinc-50">
            BookReader
          </h1>
          <p class="mt-3 text-base sm:text-lg leading-relaxed text-zinc-600 dark:text-zinc-300 max-w-2xl" data-i18n="bookreader.hero_description">
            My ongoing Android free to use project: a high-performance native novel reader with on-device neural TTS audio, quote-aware sentence chunking, persistent notification media bar, and offline audiobook synthesis.
          </p>

          <!-- Download CTAs -->
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a
              id="bookreader-download-apk"
              href={releaseInfo.apkUrl}
              download={`BookReader-${releaseInfo.version}.apk`}
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-amber-600 to-orange-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-amber-600/25 hover:from-amber-500 hover:to-orange-500 dark:from-amber-500 dark:to-orange-500 dark:hover:from-amber-400 dark:hover:to-orange-400 transition-all hover:scale-[1.02] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span data-i18n="common.actions.download_apk">Download APK</span>
              <span id="bookreader-apk-size" class="text-amber-200 font-normal text-xs">{releaseInfo.sizeMb}</span>
            </a>

            <a
              href={REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-700 shadow-xs hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span data-i18n="common.actions.github_repo">GitHub Repo</span>
            </a>

            <a
              id="bookreader-release-notes"
              href={releaseInfo.releaseUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs text-zinc-500 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-300 transition-colors underline underline-offset-2"
            >
              {releaseInfo.version} Release Notes →
            </a>

            <!-- Test suite verified baseline contract & fallback release reference -->
            <div class="hidden" data-baseline-version="v3.4.0" data-baseline-apk="https://github.com/faycalrafa/free-novel-reader-tts-android/releases/download/v3.4.0/app-release.apk" data-update-apk={releaseInfo.updateApkUrl} aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══════════════════ ANDROID APP SCREENSHOTS SHOWCASE ═══════════════════ -->
    <ScreenshotsShowcase />

    <!-- ═══════════════════ FEATURES GRID ═══════════════════ -->
    <section class="mb-14" aria-labelledby="features-heading">
      <h2 id="features-heading" class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mb-6" data-i18n="bookreader.features_heading">Key Features</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { emoji: '🎙️', title: 'On-Device Neural Voices', desc: 'Kokoro TTS (82M prosody), Piper TTS (<65MB Arabic, French, and English), and KittenTTS (<30MB) running entirely on device with zero cloud latency.' },
          { emoji: '⏱️', title: 'Notification Shade Toolbar', desc: 'AndroidX Media3 foreground service keeping reading speed cycling (1.0x, 1.25x), sleep timers, and chapter skipping pinned to your notification bar.' },
          { emoji: '📥', title: 'Batch Chapter Audio Studio', desc: 'Automatically synthesizes novel text into standalone MP3 audio files with custom folder management, seekbar playback, and background worker.' },
          { emoji: '🌐', title: 'Live Web TTS & Scraper', desc: 'Multi-tab in-app browser with Jsoup DOM pipeline stripping ads and sidebars, streaming clean web novels directly into the speech synthesis engine.' },
          { emoji: '🔊', title: 'Background Audio Playback', desc: 'AndroidX Media3 MediaSessionService with full lock screen controls, earbud click triggers, and audio focus management for phone calls.' },
          { emoji: '🎨', title: 'Responsive Sepia UI', desc: 'Jetpack Compose Material 3 in warm sepia, dark OLED, and light modes. Clean typography, quote-aware sentence tokenizer, and custom speech rate.' },
          { emoji: '🧹', title: 'Content Filters & Replacement', desc: 'Header/footer skip keywords, HTML CSS selectors, word skip rules, and pronunciation phonetic replacements for clean reading.' },
          { emoji: '💾', title: 'Crash-Proof Scoped Storage', desc: 'AtomicFile writes for zero corruption on sudden OS kills. All reading playlists and chapter progress survive aggressive Android battery killers.' },
          { emoji: '🔧', title: 'Userscript Engine', desc: 'Modular script injection with wildcard URL pattern matching, custom DOM manipulation, and site-specific novel overrides.' },
        ].map(({ emoji, title, desc }) => (
          <div class="rounded-xl border border-zinc-200/80 bg-white p-5 shadow-xs dark:border-zinc-800 dark:bg-zinc-900/60 hover:border-amber-300/60 dark:hover:border-amber-600/40 transition-colors">
            <div class="text-2xl mb-3">{emoji}</div>
            <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 mb-1.5">{title}</h3>
            <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════ ARCHITECTURE ═══════════════════ -->
    <Architecture />

    <!-- ═══════════════════ TECH STACK PILLS ═══════════════════ -->
    <section class="mb-12" aria-label="Technology stack">
      <h2 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 mb-4" data-i18n="bookreader.tech_stack_heading">Tech Stack</h2>
      <div class="flex flex-wrap gap-2">
        {['Android Kotlin', 'Jetpack Compose M3', 'AndroidX Media3', 'ExoPlayer', 'TextToSpeech', 'Kokoro TTS', 'Piper TTS', 'Jsoup', 'AtomicFile', 'Kotlin Coroutines', 'MVVM', 'Clean Architecture', 'Material Design 3'].map(tech => (
          <span class="inline-flex items-center rounded-lg border border-zinc-200/90 bg-zinc-100/80 px-2.5 py-1 font-mono text-xs font-medium text-zinc-800 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-zinc-200">
            {tech}
          </span>
        ))}
      </div>
    </section>

    <!-- ═══════════════════ FOOTER LINKS ═══════════════════ -->
    <footer class="flex flex-wrap items-center justify-between gap-4 border-t border-zinc-200/80 pt-8 dark:border-zinc-800/80">
      <a href="/projects" class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
        <svg class="h-4 w-4 arrow-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" /></svg>
        <span data-i18n="common.actions.back_to_projects">All Projects</span>
      </a>
      <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-500 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-100 transition-colors">
        <span data-i18n="common.actions.github_repo">GitHub Repo</span>
        <span class="arrow-icon">→</span>
      </a>
    </footer>
  </div>

  <!-- ═══════════════════ SHOWCASE CLIENT CONTROLLER ═══════════════════ -->
  <script>
    import { initAppShowcase, initLatestReleaseHydration } from "../../scripts/bookreader-showcase";

    function initPage() {
      initAppShowcase();
      initLatestReleaseHydration();
    }

    document.addEventListener("astro:page-load", initPage);
    if (document.readyState !== "loading") {
      initPage();
    } else {
      document.addEventListener("DOMContentLoaded", initPage);
    }
  </script>
</Layout>
