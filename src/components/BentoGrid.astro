---

<section
  id="skills"
  class="relative py-20 border-t border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-950/40"
  aria-labelledby="skills-heading"
>
  <!-- Background Glow & Grid Accents -->
  <div class="absolute inset-0 bg-[radial-gradient(#e4e4e7_1px,transparent_1px)] [background-size:24px_24px] opacity-40 dark:bg-[radial-gradient(#27272a_1px,transparent_1px)] dark:opacity-30 pointer-events-none" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-600 dark:border-blue-400/20 dark:bg-blue-400/10 dark:text-blue-400">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m18 16 4-4-4-4" />
          <path d="m6 8-4 4 4 4" />
          <path d="m14.5 4-5 16" />
        </svg>
        <span>Technical Architecture &amp; Capabilities</span>
      </div>

      <h2 id="skills-heading" class="mt-4 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50">
        Skills &amp; Architecture Matrix
      </h2>
      <p class="mt-3 text-base sm:text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
        A categorized overview of core engineering proficiencies, frameworks, and tools proven through 6+ years of technical leadership, enterprise microservices, and flagship mobile applications.
      </p>
    </div>

    <!-- Responsive Bento Grid Layout -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
      {clusters.map((cluster) => (
        <article
          id={`skill-cluster-${cluster.id}`}
          class={`relative flex flex-col justify-between overflow-hidden rounded-2xl border bg-white p-6 sm:p-8 shadow-xs dark:bg-zinc-900/90 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${cluster.colSpan} ${cluster.theme.border} ${cluster.theme.hoverBorder}`}
        >
          <!-- Subtle Glowing Corner Accent -->
          <div
            class={`absolute -right-16 -top-16 h-48 w-48 rounded-full bg-gradient-to-br ${cluster.theme.glowBg} blur-2xl pointer-events-none`}
            aria-hidden="true"
          />

          <!-- Card Header & Metadata -->
          <div>
            <div class="flex items-center justify-between gap-4">
              <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
                {cluster.category}
              </span>
              <div class="flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-semibold border-zinc-200 bg-zinc-100/80 text-zinc-700 dark:border-zinc-800 dark:bg-zinc-800/80 dark:text-zinc-300">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                <span>Production Verified</span>
              </div>
            </div>

            <!-- Cluster Semantic Heading (H3) -->
            <h3 class="mt-3 text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
              {cluster.title}
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {cluster.subtitle}
            </p>

            <!-- Skill Badges Pill Cloud -->
            <div class="mt-6">
              <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                Core Technologies &amp; Tools
              </h4>
              <div class="mt-3 flex flex-wrap gap-2">
                {cluster.skills.map((skill) => (
                  <span
                    class={`inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 text-xs font-medium transition-colors ${
                      skill.featured
                        ? `${cluster.theme.badgeBg} ${cluster.theme.badgeText} font-semibold shadow-2xs`
                        : "border-zinc-200/80 bg-zinc-50 text-zinc-700 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-800/50 dark:text-zinc-300 dark:hover:bg-zinc-800"
                    }`}
                    title={skill.note ? `${skill.name}: ${skill.note}` : skill.name}
                  >
                    <span>{skill.name}</span>
                    {skill.note && (
                      <span class="hidden sm:inline text-[10px] opacity-75 font-normal">
                        • {skill.note.split(',')[0]}
                      </span>
                    )}
                  </span>
                ))}
              </div>
            </div>

            <!-- Architectural Highlights -->
            <div class="mt-6 border-t border-zinc-100 dark:border-zinc-800/80 pt-4">
              <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                Architectural Highlights
              </h4>
              <ul class="mt-2.5 space-y-2 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
                {cluster.architecturalHighlights.map((highlight) => (
                  <li class="flex items-start gap-2">
                    <svg
                      class={`mt-0.5 h-4 w-4 shrink-0 ${cluster.theme.accentColor}`}
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom: Verified Real-World Projects & Proof Links -->
          <div class="mt-6 border-t border-zinc-100 dark:border-zinc-800/80 pt-4">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
              Verified Project Proofs
            </h4>
            <div class="mt-2.5 flex flex-wrap gap-2">
              {cluster.projectProofs.map((project) => (
                <a
                  href={project.url}
                  class="group inline-flex items-center gap-2 rounded-xl border border-zinc-200/90 bg-zinc-50/80 px-3 py-2 text-xs text-zinc-700 hover:border-zinc-400 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-800/40 dark:text-zinc-300 dark:hover:border-zinc-600 dark:hover:bg-zinc-800 transition-all"
                >
                  <span class="font-semibold text-zinc-900 dark:text-zinc-100 group-hover:underline">
                    {project.name}
                  </span>
                  <span class={`rounded px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider ${cluster.theme.badgeBg} ${cluster.theme.badgeText}`}>
                    {project.badge}
                  </span>
                  <svg
                    class="h-3 w-3 text-zinc-400 group-hover:text-zinc-600 dark:group-hover:text-zinc-200 transition-transform group-hover:translate-x-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
