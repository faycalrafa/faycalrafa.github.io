---
// src/components/FeaturedProjects.astro
// Flagship Projects Showcase for Faycal Rafa Portfolio
// 5 authoritative projects with full-screen snap locking and clean edge-to-edge layouts
import TextMorphSlide from './slides/TextMorphSlide.astro';
import SabilSlide from './slides/SabilSlide.astro';
---

<section id="projects" class="relative">
  <!-- Fixed Left Animated Laser Progress Bar (Career Journey style) -->
  <div
    id="projects-laser-bar"
    class="fixed left-2 sm:left-6 md:left-8 top-1/2 -translate-y-1/2 z-30 transition-all duration-500 pointer-events-none opacity-0 -translate-x-6"
    aria-hidden="true"
  >
    <!-- Base track matching Career Journey w-0.5 bg-zinc-200 dark:bg-zinc-800 -->
    <div class="relative h-48 sm:h-60 md:h-72 w-0.5 bg-zinc-200/80 dark:bg-zinc-800 rounded-full">
      <!-- Vertical Glowing Laser Progress Line matching Career Journey -->
      <div
        id="projects-laser-fill"
        class="absolute top-0 left-0 w-full bg-gradient-to-b from-blue-500 via-indigo-500 to-emerald-400 shadow-[0_0_8px_rgba(59,130,246,0.8),0_0_5px_rgba(99,102,241,0.6)] rounded-full transition-all duration-300"
        style="height: 20%;"
      ></div>

      <!-- 5 Timeline Node Beacons corresponding to the 5 projects -->
      <div class="absolute inset-y-0 -left-[5px] flex flex-col justify-between py-0.5">
        <div class="project-laser-beacon h-3 w-3 rounded-full border-2 border-blue-500 bg-blue-500 ring-4 ring-blue-500/20 shadow-md shadow-blue-500/30 transition-all duration-300" data-slide-index="0"></div>
        <div class="project-laser-beacon h-2.5 w-2.5 rounded-full border-2 border-zinc-400 dark:border-zinc-700 bg-white dark:bg-zinc-900 transition-all duration-300" data-slide-index="1"></div>
        <div class="project-laser-beacon h-2.5 w-2.5 rounded-full border-2 border-zinc-400 dark:border-zinc-700 bg-white dark:bg-zinc-900 transition-all duration-300" data-slide-index="2"></div>
        <div class="project-laser-beacon h-2.5 w-2.5 rounded-full border-2 border-zinc-400 dark:border-zinc-700 bg-white dark:bg-zinc-900 transition-all duration-300" data-slide-index="3"></div>
        <div class="project-laser-beacon h-2.5 w-2.5 rounded-full border-2 border-zinc-400 dark:border-zinc-700 bg-white dark:bg-zinc-900 transition-all duration-300" data-slide-index="4"></div>
      </div>
    </div>
  </div>

  <!-- Slide 1: BookReader Pro (Current Free-to-Use Flagship Android App) -->
  <div class="project-snap-slide min-h-screen h-[100dvh] snap-start snap-always flex items-center justify-center pl-10 pr-3.5 py-4 sm:px-6 sm:py-6 lg:p-8 relative" data-slide-index="0">
    <article class="project-timeline-item w-full max-w-6xl h-auto min-h-[62dvh] sm:h-auto max-h-[85dvh] sm:max-h-[92dvh] overflow-hidden rounded-3xl border border-zinc-200/80 bg-white/95 p-4 sm:p-8 md:p-10 shadow-xl transition-all duration-300 hover:border-amber-500/40 hover:shadow-2xl dark:border-zinc-800/80 dark:bg-zinc-900/90 dark:hover:border-amber-500/30 flex flex-col justify-center">
      
      <!-- Top Slide Indicator Pill (Desktop/tablet only, hidden on mobile to reclaim vertical space) -->
      <div class="hidden sm:flex items-center justify-between mb-3 border-b border-zinc-100 dark:border-zinc-800/60 pb-2">
        <span class="text-xs font-mono font-semibold text-amber-600 dark:text-amber-400">
          Featured Project 01 / 05
        </span>
        <span class="text-[11px] text-zinc-400 font-mono">
          Scroll down ↓ to snap
        </span>
      </div>

      <div class="flex flex-col justify-center lg:grid lg:grid-cols-12 gap-2 sm:gap-5 lg:gap-8 lg:items-center">
        <!-- Text Meta Column -->
        <div class="lg:col-span-7 flex flex-col justify-center min-h-0">
          <div class="space-y-1.5 sm:space-y-2">
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 px-2 sm:px-2.5 py-0.5 text-[11px] sm:text-xs font-semibold text-amber-700 dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-400">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse" aria-hidden="true"></span>
                Flagship App • Free to Use
              </span>
              <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-[11px] sm:text-xs font-mono font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                Android Native
              </span>
            </div>

            <h3 class="text-xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-amber-500 transition-colors">
              BookReader Pro
            </h3>
            <p class="text-xs sm:text-sm font-medium text-amber-600 dark:text-amber-400 line-clamp-1 sm:line-clamp-none">
              On-Device AI Neural Audio &amp; Offline Novel Reader
            </p>

            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-snug sm:leading-relaxed line-clamp-3 sm:line-clamp-none">
              A private, 100% free offline reader pairing on-device neural TTS with uninterrupted background audio playback and zero cloud dependency.
            </p>

            <!-- Role & Impact Bullets -->
            <ul class="space-y-1 sm:space-y-1.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
              <li class="flex items-start gap-1.5 sm:gap-2">
                <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0">Role:</span>
                <span class="leading-snug sm:leading-relaxed">Solo Creator &amp; Lead Android Engineer. Built Kotlin M3 UI, C++ neural model runtime, and Media3 background service.</span>
              </li>
              <li class="flex items-start gap-1.5 sm:gap-2">
                <span class="font-bold text-emerald-600 dark:text-emerald-400 shrink-0">Impact:</span>
                <span class="leading-snug sm:leading-relaxed">Shipped Kokoro 82M &amp; Piper on-device TTS with zero telemetry, surviving aggressive OS battery killers.</span>
              </li>
            </ul>

            <!-- Tech Stack Tags -->
            <div class="flex flex-wrap gap-1 sm:gap-1.5" aria-label="BookReader tech stack">
              {['Kotlin', 'Jetpack Compose', 'AndroidX Media3', 'Kokoro TTS', 'Piper C++', 'Scoped Storage'].map((tech, i) => (
                <span class:list={['inline-flex items-center rounded-md border border-zinc-200/80 bg-zinc-100/90 px-1.5 py-0.5 sm:px-2 text-[10px] sm:text-[11px] font-mono font-medium text-zinc-700 dark:border-zinc-800 dark:bg-zinc-800/80 dark:text-zinc-300', i >= 4 && 'hidden sm:inline-flex']}>
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Action CTAs -->
          <div class="mt-3 sm:mt-4 flex flex-wrap items-center gap-2 sm:gap-2.5 pt-2.5 sm:pt-3 border-t border-zinc-100 dark:border-zinc-800/60 shrink-0">
            <a
              href="/projects/bookreader"
              class="inline-flex items-center gap-1.5 rounded-xl bg-amber-600 hover:bg-amber-500 px-3 py-1.5 sm:px-3.5 sm:py-2 text-xs font-semibold text-white shadow-xs transition-colors"
            >
              <span>Flagship Showcase</span>
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
              </svg>
            </a>

            <a
              href="https://github.com/faycalrafa/free-novel-reader-tts-android/releases/tag/v3.4.0"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 sm:px-3.5 sm:py-2 text-xs font-semibold text-emerald-700 dark:text-emerald-300 hover:bg-emerald-500/20 transition-colors"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v8.69l2.22-2.22a.75.75 0 111.06 1.06l-3.5 3.5a.75.75 0 01-1.06 0l-3.5-3.5a.75.75 0 111.06-1.06l2.22 2.22V3.75A.75.75 0 0110 3z" clip-rule="evenodd" />
                <path d="M3.75 16.5A.75.75 0 003 17.25c0 .414.336.75.75.75h12.5a.75.75 0 00.75-.75.75.75 0 00-.75-.75H3.75z" />
              </svg>
              <span>Download APK (v3.4.0)</span>
            </a>

            <a
              href="https://github.com/faycalrafa/free-novel-reader-tts-android"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-zinc-200 bg-zinc-50 px-3 py-1.5 sm:px-3 sm:py-2 text-xs font-medium text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 transition-colors"
            >
              <span>GitHub Repo</span>
            </a>
          </div>
        </div>

        <!-- Screenshot Column -->
        <div class="lg:col-span-5 flex justify-center order-first lg:order-last shrink-0 py-1 sm:py-0">
          <img
            src="/images/bookreader/screenshot-01-home.jpg"
            alt="BookReader Pro Android App Screenshot"
            loading="lazy"
            decoding="async"
            class="max-h-[24vh] sm:max-h-[35vh] lg:max-h-[46vh] w-auto rounded-2xl shadow-xl ring-1 ring-zinc-800/80 object-contain transition-transform duration-300 group-hover:scale-102"
          />
        </div>
      </div>
    </article>
  </div>

  <!-- Slide 2: StoresDZ (Shopify, but open and built for Algeria) -->
  <div class="project-snap-slide min-h-screen h-[100dvh] snap-start snap-always flex items-center justify-center pl-10 pr-3.5 py-4 sm:px-6 sm:py-6 lg:p-8 relative" data-slide-index="1">
    <article class="project-timeline-item w-full max-w-6xl h-auto min-h-[62dvh] sm:h-auto max-h-[85dvh] sm:max-h-[92dvh] overflow-hidden rounded-3xl border border-zinc-200/80 bg-white/95 p-4 sm:p-8 md:p-10 shadow-xl transition-all duration-300 hover:border-blue-500/40 hover:shadow-2xl dark:border-zinc-800/80 dark:bg-zinc-900/90 dark:hover:border-blue-500/30 flex flex-col justify-center">
      
      <!-- Top Slide Indicator Pill (Desktop/tablet only, hidden on mobile to reclaim vertical space) -->
      <div class="hidden sm:flex items-center justify-between mb-3 border-b border-zinc-100 dark:border-zinc-800/60 pb-2">
        <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400">
          Featured Project 02 / 05
        </span>
        <span class="text-[11px] text-zinc-400 font-mono">
          Scroll down ↓ to snap
        </span>
      </div>

      <div class="flex flex-col justify-center lg:grid lg:grid-cols-12 gap-2 sm:gap-5 lg:gap-8 lg:items-center">
        <!-- Text Meta Column -->
        <div class="lg:col-span-7 flex flex-col justify-center min-h-0">
          <div class="space-y-1.5 sm:space-y-2">
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-500/30 bg-blue-500/10 px-2 sm:px-2.5 py-0.5 text-[11px] sm:text-xs font-semibold text-blue-700 dark:border-blue-400/30 dark:bg-blue-400/10 dark:text-blue-400">
                <span class="h-1.5 w-1.5 rounded-full bg-blue-500" aria-hidden="true"></span>
                Multi-Tenant Platform
              </span>
              <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-[11px] sm:text-xs font-mono font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                Shopify for Algeria
              </span>
            </div>

            <h3 class="text-xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-blue-500 transition-colors">
              StoresDZ
            </h3>
            <p class="text-xs sm:text-sm font-medium text-blue-600 dark:text-blue-400 line-clamp-1 sm:line-clamp-none">
              Full-Stack Multi-Tenant E-Commerce Platform
            </p>

            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-snug sm:leading-relaxed line-clamp-3 sm:line-clamp-none">
              Think Shopify, but open and built for Algeria — powering localized custom storefronts, sales funnels, and cash-on-delivery tracking.
            </p>

            <!-- Role & Impact Bullets -->
            <ul class="space-y-1 sm:space-y-1.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
              <li class="flex items-start gap-1.5 sm:gap-2">
                <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0">Role:</span>
                <span class="leading-snug sm:leading-relaxed">Fullstack Engineer. Connected merchant storefronts to commerce microservices, built reusable themes.</span>
              </li>
              <li class="flex items-start gap-1.5 sm:gap-2">
                <span class="font-bold text-emerald-600 dark:text-emerald-400 shrink-0">Impact:</span>
                <span class="leading-snug sm:leading-relaxed">Delivered multi-tenant architecture supporting 7 distinct industry themes and high-velocity order management.</span>
              </li>
            </ul>

            <!-- Tech Stack Tags -->
            <div class="flex flex-wrap gap-1 sm:gap-1.5" aria-label="StoresDZ tech stack">
              {['TypeScript', 'React', 'Go', 'Rust', 'Redis', 'Docker'].map((tech, i) => (
                <span class:list={['inline-flex items-center rounded-md border border-zinc-200/80 bg-zinc-100/90 px-1.5 py-0.5 sm:px-2 text-[10px] sm:text-[11px] font-mono font-medium text-zinc-700 dark:border-zinc-800 dark:bg-zinc-800/80 dark:text-zinc-300', i >= 4 && 'hidden sm:inline-flex']}>
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Action CTAs -->
          <div class="mt-3 sm:mt-4 flex flex-wrap items-center gap-2 sm:gap-2.5 pt-2.5 sm:pt-3 border-t border-zinc-100 dark:border-zinc-800/60 shrink-0">
            <a
              href="/projects/storesdz"
              class="inline-flex items-center gap-1.5 rounded-xl bg-blue-600 hover:bg-blue-500 px-3 py-1.5 sm:px-3.5 sm:py-2 text-xs font-semibold text-white shadow-xs transition-colors"
            >
              <span>Read More</span>
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
              </svg>
            </a>

            <a
              href="https://app.storesdz.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-zinc-200 bg-zinc-50 px-3 py-1.5 sm:px-3 sm:py-2 text-xs font-medium text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 transition-colors"
            >
              <span>app.storesdz.com</span>
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 3h6v6" /><path d="M10 10l7-7" /><path d="M17 11v6a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h6" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Screenshot Column -->
        <div class="lg:col-span-5 flex justify-center order-first lg:order-last shrink-0 py-1 sm:py-0">
          <img
            src="/images/projects/storesdz/storesdz-site-screenshot.webp"
            alt="StoresDZ Multi-Tenant E-Commerce Platform Screenshot"
            loading="lazy"
            decoding="async"
            class="max-h-[24vh] sm:max-h-[35vh] lg:max-h-[46vh] w-auto rounded-2xl shadow-xl ring-1 ring-zinc-800/80 object-contain transition-transform duration-300 group-hover:scale-102"
          />
        </div>
      </div>
    </article>
  </div>

  <!-- Slide 3: TextMorph (System-Wide Multimodal On-Device AI Assistant) -->
  <TextMorphSlide />

  <!-- Slide 4: SABIL Mega-App -->
  <SabilSlide />

  <!-- Slide 5: InvestMarket (Standalone Project at Finnetude) -->
  <div class="project-snap-slide min-h-screen h-[100dvh] snap-start snap-always flex items-center justify-center pl-10 pr-3.5 py-4 sm:px-6 sm:py-6 lg:p-8 relative" data-slide-index="4">
    <article class="project-timeline-item w-full max-w-6xl h-auto min-h-[62dvh] sm:h-auto max-h-[85dvh] sm:max-h-[92dvh] overflow-hidden rounded-3xl border border-zinc-200/80 bg-white/95 p-4 sm:p-8 md:p-10 shadow-xl transition-all duration-300 hover:border-indigo-500/40 hover:shadow-2xl dark:border-zinc-800/80 dark:bg-zinc-900/90 dark:hover:border-indigo-500/30 flex flex-col justify-center">
      
      <!-- Top Slide Indicator Pill (Desktop/tablet only, hidden on mobile to reclaim vertical space) -->
      <div class="hidden sm:flex items-center justify-between mb-3 border-b border-zinc-100 dark:border-zinc-800/60 pb-2">
        <span class="text-xs font-mono font-semibold text-indigo-600 dark:text-indigo-400">
          Featured Project 05 / 05
        </span>
        <span class="text-[11px] text-zinc-400 font-mono">
          Scroll down ↓ to snap to Contact
        </span>
      </div>

      <div class="flex flex-col justify-center lg:grid lg:grid-cols-12 gap-2 sm:gap-5 lg:gap-8 lg:items-center">
        <!-- Text Meta Column -->
        <div class="lg:col-span-7 flex flex-col justify-center min-h-0">
          <div class="space-y-1.5 sm:space-y-2">
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-2 sm:px-2.5 py-0.5 text-[11px] sm:text-xs font-semibold text-indigo-700 dark:border-indigo-400/30 dark:bg-indigo-400/10 dark:text-indigo-400">
                <span class="h-1.5 w-1.5 rounded-full bg-indigo-500" aria-hidden="true"></span>
                Financial Platform &amp; Brokerage
              </span>
              <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-[11px] sm:text-xs font-mono font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                COSOB Accredited
              </span>
            </div>

            <h3 class="text-xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-500 transition-colors">
              InvestMarket
            </h3>
            <p class="text-xs sm:text-sm font-medium text-indigo-600 dark:text-indigo-400 line-clamp-1 sm:line-clamp-none">
              Outil de gestion de portefeuille et d'analyse de performance boursière
            </p>

            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-snug sm:leading-relaxed line-clamp-3 sm:line-clamp-none">
              Plateforme financière institutionnelle développée chez Finnetude pour la négociation de titres, la valorisation de portefeuilles en temps réel et l'analyse de performance.
            </p>

            <!-- Role & Impact Bullets -->
            <ul class="space-y-1 sm:space-y-1.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
              <li class="flex items-start gap-1.5 sm:gap-2">
                <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0">Role:</span>
                <span class="leading-snug sm:leading-relaxed">Technical Lead. Co-architected orderbook routing, streaming market feeds, and PostgreSQL models.</span>
              </li>
              <li class="flex items-start gap-1.5 sm:gap-2">
                <span class="font-bold text-emerald-600 dark:text-emerald-400 shrink-0">Impact:</span>
                <span class="leading-snug sm:leading-relaxed">Passerelles WebSockets temps réel, conformité COSOB, Transactional Outbox, et -65 % requêtes base.</span>
              </li>
            </ul>

            <!-- Tech Stack Tags -->
            <div class="flex flex-wrap gap-1 sm:gap-1.5" aria-label="InvestMarket tech stack">
              {['NestJS', 'TypeScript', 'WebSockets', 'PostgreSQL', 'Redis', 'Docker'].map((tech, i) => (
                <span class:list={['inline-flex items-center rounded-md border border-zinc-200/80 bg-zinc-100/90 px-1.5 py-0.5 sm:px-2 text-[10px] sm:text-[11px] font-mono font-medium text-zinc-700 dark:border-zinc-800 dark:bg-zinc-800/80 dark:text-zinc-300', i >= 4 && 'hidden sm:inline-flex']}>
                  {tech}
                </span>
              ))}
            </div>
          </div>

          <!-- Action CTAs -->
          <div class="mt-3 sm:mt-4 flex flex-wrap items-center gap-2 sm:gap-2.5 pt-2.5 sm:pt-3 border-t border-zinc-100 dark:border-zinc-800/60 shrink-0">
            <a
              href="/projects/investmarket"
              class="inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 px-3 py-1.5 sm:px-3.5 sm:py-2 text-xs font-semibold text-white shadow-xs transition-colors"
            >
              <span>Read More</span>
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
              </svg>
            </a>

            <a
              href="https://investmarket-dz.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-xl border border-zinc-200 bg-zinc-50 px-3 py-1.5 sm:px-3 sm:py-2 text-xs font-medium text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 transition-colors"
            >
              <span>investmarket-dz.com</span>
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M11 3h6v6" /><path d="M10 10l7-7" /><path d="M17 11v6a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h6" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Screenshot Column -->
        <div class="lg:col-span-5 flex justify-center order-first lg:order-last shrink-0 py-1 sm:py-0">
          <img
            src="/images/projects/finnetude/investmarket-shares-wallet-manager-screenshot.png"
            alt="InvestMarket Stock Trading & Portfolio Management Interface"
            loading="lazy"
            decoding="async"
