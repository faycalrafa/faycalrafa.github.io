<script>
  function initProjectsLaser() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const laser = document.getElementById('projects-progress-laser');
      if (laser) laser.style.height = '100%';
      return;
    }
    const container = document.querySelector<HTMLElement>('.projects-timeline-container');
    const laser = document.getElementById('projects-progress-laser');
    const items = document.querySelectorAll<HTMLElement>('.project-timeline-item');
    if (!container || !laser) return;

    function onScroll() {
      if (!container || !laser) return;
      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const startY = windowHeight * 0.75;
      const totalDist = rect.height;
      const scrolled = startY - rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / totalDist));
      laser.style.height = `${(progress * 100).toFixed(1)}%`;

      items.forEach((item) => {
        const itemRect = item.getBoundingClientRect();
        const beacon = item.querySelector<HTMLElement>('.project-beacon');
        if (!beacon) return;
        const activeClass = beacon.getAttribute('data-active-class');
        if (!activeClass) return; // Project 1 BookReader has permanent amber beacon
        const classes = activeClass.split(' ');
        if (itemRect.top < windowHeight * 0.65) {
          beacon.classList.add(...classes);
          beacon.classList.remove('bg-zinc-300', 'dark:bg-zinc-700');
        } else {
          beacon.classList.remove(...classes);
          beacon.classList.add('bg-zinc-300', 'dark:bg-zinc-700');
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  document.addEventListener('astro:page-load', initProjectsLaser);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initProjectsLaser();
  } else {
    document.addEventListener('DOMContentLoaded', initProjectsLaser);
  }
</script>
