---
// src/components/Footer.astro
// Production Blueprint for Faycal Rafa Portfolio
// Compliant with Astro 5, Tailwind CSS v4, and modern accessibility standards.

import LanguageChanger from './LanguageChanger.astro';

const currentYear = new Date().getFullYear();
---

<footer id="site-footer" style="scroll-snap-align: none;" class="border-t border-zinc-200/80 bg-zinc-50 transition-colors duration-200 dark:border-zinc-800/80 dark:bg-zinc-950" role="contentinfo">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    


    <!-- Middle Section: 3-Column Directory Grid -->
    <div class="grid grid-cols-1 gap-8 py-12 md:grid-cols-2 lg:grid-cols-3 border-b border-zinc-200/80 dark:border-zinc-800/80">
      
      <!-- Col 1: Identity & Bio -->
      <div class="space-y-4">
        <a href="/" class="group flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-blue-600 to-indigo-600 font-mono text-xs font-bold text-white shadow-2xs">
            FR
          </div>
          <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            Faycal Rafa
          </span>
        </a>
        <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400" data-i18n="common.footer.bio_summary">
          Fullstack Engineer with 6+ years building scalable microservices, high-throughput financial platforms, and native Android applications. Open to full-time, contract, and freelance opportunities.
        </p>
        <div class="flex items-center gap-2 pt-2">
          <!-- WhatsApp -->
          <a
            href="https://wa.me/213540980238"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-emerald-600 hover:bg-emerald-500/10 dark:text-emerald-400 dark:hover:bg-emerald-950/40 transition-colors"
            aria-label="Direct WhatsApp Chat"
            title="WhatsApp: +213 540 98 02 38"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
          </a>
          <!-- Direct Phone Call -->
          <a
            href="tel:+213540980238"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-zinc-500 hover:text-zinc-900 hover:bg-zinc-200/60 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800/60 transition-colors"
            aria-label="Direct Call (+213 540 98 02 38)"
            title="Phone: +213 540 98 02 38"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
          </a>
          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/faycal-rafa-89a366249"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-[#0A66C2] hover:bg-blue-50 dark:hover:bg-blue-950/40 transition-colors"
            aria-label="Faycal Rafa LinkedIn Profile"
            title="LinkedIn Profile"
          >
            <svg class="h-4 w-4 fill-currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
            </svg>
          </a>
          <!-- GitHub -->
          <a
            href="https://github.com/faycalrafa"
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-zinc-500 hover:text-zinc-900 hover:bg-zinc-200/60 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800/60 transition-colors"
            aria-label="Faycal Rafa GitHub Profile"
            title="GitHub: @faycalrafa"
          >
            <svg class="h-4 w-4 fill-currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
          <!-- Email -->
          <a
            href="mailto:rafafaycal@gmail.com"
            class="flex h-8 w-8 items-center justify-center rounded-lg text-zinc-500 hover:text-zinc-900 hover:bg-zinc-200/60 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800/60 transition-colors"
            aria-label="Email Faycal Rafa"
            title="Email: rafafaycal@gmail.com"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </a>
        </div>

        <!-- Language Switcher in Footer -->
        <div class="pt-4 border-t border-zinc-200/60 dark:border-zinc-800/60">
          <LanguageChanger variant="footer" />
        </div>
      </div>

      <!-- Col 2: Featured Projects -->
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-200" data-i18n="common.footer.flagships">
          Featured Works
        </p>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/projects/bookreader" class="group inline-flex items-center gap-1.5 text-zinc-600 hover:text-amber-600 dark:text-zinc-400 dark:hover:text-amber-400 transition-colors">
              <span class="ltr-isolate">BookReader Android App</span>
              <span class="rounded bg-amber-500/10 px-1 py-0.2 text-[9px] font-semibold text-amber-600 dark:bg-amber-400/10 dark:text-amber-400 border border-amber-500/20" data-i18n="common.badges.free_to_use">
                Free to Use
              </span>
            </a>
          </li>
          <li>
            <a href="/projects/storesdz" class="group inline-flex items-center gap-1.5 text-zinc-600 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors">
              <span class="ltr-isolate">StoresDZ Platform</span>
              <span class="rounded bg-blue-500/10 px-1 py-0.2 text-[9px] font-semibold text-blue-600 dark:bg-blue-400/10 dark:text-blue-400 border border-blue-500/20">
                E-Commerce
              </span>
            </a>
          </li>
          <li>
            <a href="/projects/textmorph" class="group inline-flex items-center gap-1.5 text-zinc-600 hover:text-purple-600 dark:text-zinc-400 dark:hover:text-purple-400 transition-colors">
              <span class="ltr-isolate">TextMorph AI Assistant</span>
              <span class="rounded bg-purple-500/10 px-1 py-0.2 text-[9px] font-semibold text-purple-600 dark:bg-purple-400/10 dark:text-purple-400 border border-purple-500/20">
                On-Device AI
              </span>
            </a>
          </li>
          <li>
            <a href="/projects/sabil" class="group inline-flex items-center gap-1.5 text-zinc-600 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors">
              <span class="ltr-isolate">Sabil Mega-App</span>
              <span class="rounded bg-zinc-100 dark:bg-zinc-800 px-1 py-0.2 text-[9px] font-medium text-zinc-500" data-i18n="common.badges.commercial">
                Commercial
              </span>
            </a>
          </li>
          <li>
            <a href="/projects" class="group inline-flex items-center gap-1.5 text-zinc-600 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors">
              <span class="ltr-isolate">InvestMarket (Finnetude)</span>
              <span class="rounded bg-zinc-100 dark:bg-zinc-800 px-1 py-0.2 text-[9px] font-medium text-zinc-500">
                Fintech
              </span>
            </a>
          </li>
          <li>
            <a href="/projects" class="group inline-flex items-center gap-1.5 text-zinc-600 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors">
              <span class="ltr-isolate">PIASSA DZ Automotive SaaS</span>
              <span class="rounded bg-zinc-100 dark:bg-zinc-800 px-1 py-0.2 text-[9px] font-medium text-zinc-500">
                SaaS
              </span>
            </a>
          </li>
          <li>
            <a href="/projects" class="group inline-flex items-center gap-1.5 text-zinc-600 hover:text-emerald-600 dark:text-zinc-400 dark:hover:text-emerald-400 transition-colors">
              <span class="ltr-isolate">StartingPack Svelte 5</span>
              <span class="rounded bg-emerald-500/10 px-1 py-0.2 text-[9px] font-semibold text-emerald-600 dark:bg-emerald-400/10 dark:text-emerald-400 border border-emerald-500/20" data-i18n="common.badges.free_to_use">
                Free to Use
              </span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Resources & Command Palette -->
      <div class="space-y-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-200" data-i18n="common.footer.quick_links">
          Resources & Assets
        </p>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="/cv"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-zinc-600 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors"
            >
              <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 3v10" />
                <path d="M6 9l4 4 4-4" />
                <path d="M3 15v1a2 2 0 002 2h10a2 2 0 002-2v-1" />
              </svg>
              <span data-i18n="common.footer.cv_link">Faycal Rafa CV</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/faycalrafa/free-novel-reader-tts-android/releases/tag/v3.4.0"
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-600 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors"
            >
              <span class="ltr-isolate">BookReader APK (v3.4.0 Release)</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/faycalrafa"
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-600 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors"
            >
              <span data-i18n="common.footer.github_repos">GitHub Repositories (@faycalrafa)</span>
            </a>
          </li>
          <li>
            <button
              type="button"
              id="footer-search-trigger"
              class="inline-flex items-center gap-1.5 text-zinc-600 hover:text-blue-600 dark:text-zinc-400 dark:hover:text-blue-400 transition-colors cursor-pointer"
            >
              <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="8.5" cy="8.5" r="5.5" />
                <path d="M17.5 17.5L12.5 12.5" />
              </svg>
              <span data-i18n="common.footer.command_palette_trigger">Command Palette (<kbd class="font-mono text-[10px]">⌘K</kbd>)</span>
            </button>
          </li>
        </ul>
      </div>


    </div>

    <!-- Bottom Bar: Copyright & Back-to-Top -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 text-xs text-zinc-500 dark:text-zinc-400">
      <div class="flex items-center gap-2 text-center sm:text-left">
        <p data-i18n="common.footer.rights">© {currentYear} Faycal Rafa. All rights reserved.</p>
      </div>

      <!-- Back to Top Button -->
      <button
        type="button"
        id="footer-back-to-top"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-600 hover:text-zinc-900 hover:bg-zinc-200/60 dark:text-zinc-400 dark:hover:text-zinc-100 dark:hover:bg-zinc-800/60 transition-colors focus-visible:outline-2 focus-visible:outline-blue-600"
        aria-label="Scroll back to top of page"
      >
        <span data-i18n="common.footer.back_to_top">Back to top</span>
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 16V4" />
          <path d="M4 10l6-6 6 6" />
        </svg>
      </button>
    </div>

  </div>
</footer>

<script>
  function initFooter() {
    // Back to top smooth scroll
    const backToTopBtn = document.getElementById('footer-back-to-top');
    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Command palette trigger from footer
    const footerSearchBtn = document.getElementById('footer-search-trigger');
    footerSearchBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-command-palette'));
    });
  }

  document.addEventListener('astro:page-load', initFooter);
</script>
