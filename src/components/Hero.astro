---
// src/components/Hero.astro
// High-impact Hero Header Component for Faycal Rafa Portfolio
// Compliant with Astro 5 ClientRouter, Tailwind CSS v4, and modern accessibility standards.
import CvModal from './CvModal.astro';
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28">
  <!-- Subtle ambient decorative gradients -->
  <div class="pointer-events-none absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
    <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-blue-600 to-indigo-400 opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem] dark:opacity-15"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      
      <!-- Availability Status Badge with Pulsing Emerald Beacon -->
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-700 dark:border-emerald-400/20 dark:bg-emerald-400/10 dark:text-emerald-400 backdrop-blur-xs transition-colors">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>Available for New Opportunities • Senior &amp; Tech Lead Roles</span>
      </div>

      <!-- Main Headline & Name -->
      <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl lg:text-6xl dark:text-zinc-50">
        Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 dark:from-blue-400 dark:via-indigo-400 dark:to-purple-400">Faycal Rafa</span>
      </h1>

      <!-- Senior Title & Technical Role -->
      <p class="mt-3 text-xl font-semibold text-zinc-800 sm:text-2xl dark:text-zinc-200">
        Senior Software Engineer &amp; Technical Lead
      </p>

      <!-- Subtitle Tagline -->
      <p class="mt-1 text-sm font-medium text-blue-600 sm:text-base dark:text-blue-400">
        Innovative Software Developer — Creating Efficient and Scalable Solutions
      </p>

      <!-- Authoritative CV Bio Blockquote -->
      <div class="mt-5 max-w-2xl">
        <blockquote class="border-l-2 border-blue-500/60 pl-4 text-base italic leading-relaxed text-zinc-700 sm:text-lg dark:text-zinc-300">
          "Dedicated Software Developer with a genuine passion for building scalable web and mobile applications. I thrive on solving complex technical challenges — whether architecting microservices or crafting intuitive user interfaces. Beyond writing code, I value collaboration and mentoring, ensuring we not only deliver high-quality solutions but also grow stronger as a team."
        </blockquote>
        <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
          6+ years architecting enterprise microservices, modern TypeScript applications, and native Android software across fintech, automotive SaaS, e-commerce, and logistics.
        </p>
      </div>

      <!-- Action CTAs Cluster -->
      <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
        <!-- Primary Action 1: Direct CV Download -->
        <a
          href="/Faycal_Rafa_CV_2026.pdf"
          download="Faycal_Rafa_CV_2026.pdf"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-md hover:bg-blue-500 dark:bg-blue-500 dark:hover:bg-blue-400 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
          aria-label="Download Faycal Rafa CV (PDF)"
        >
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 3v10" /><path d="M6 9l4 4 4-4" /><path d="M3 15v1a2 2 0 002 2h10a2 2 0 002-2v-1" />
          </svg>
          <span>Download CV</span>
        </a>

        <!-- Secondary Action 2: View CV Inline Modal Trigger -->
        <button
          type="button"
          id="open-cv-modal-btn"
          data-open-cv-modal
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-300 bg-white px-5 py-3 text-sm font-semibold text-zinc-800 shadow-xs hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800 transition-colors focus-visible:outline-2 focus-visible:outline-blue-600 cursor-pointer"
          aria-label="View Faycal Rafa CV in interactive modal viewer"
        >
          <svg class="h-4 w-4 text-zinc-500 dark:text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
          <span>View CV</span>
        </button>

        <!-- Flagship Project Quick Teaser Action -->
        <a
          href="/projects/bookreader"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-700 px-5 py-3 text-sm font-semibold text-white shadow-md hover:from-amber-500 hover:to-amber-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 transition-all"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
            <path d="M6 6h10" /><path d="M6 10h10" />
          </svg>
          <span>Explore BookReader Flagship</span>
          <span class="rounded bg-amber-900/40 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-amber-200">Hobby</span>
        </a>
      </div>

      <!-- Quick Stats Counter Bento Row -->
      <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3 max-w-3xl">
        <!-- Stat 1: Years Experience -->
        <div class="rounded-2xl border border-zinc-200/80 bg-white/70 p-4 shadow-xs backdrop-blur-xs dark:border-zinc-800/80 dark:bg-zinc-900/60 transition-colors">
          <div class="text-2xl font-black tracking-tight text-blue-600 dark:text-blue-400">6+</div>
          <div class="mt-1 text-xs font-semibold text-zinc-900 dark:text-zinc-100">Years Experience</div>
          <div class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">Software engineering &amp; tech leadership</div>
        </div>

        <!-- Stat 2: Companies & Platforms -->
        <div class="rounded-2xl border border-zinc-200/80 bg-white/70 p-4 shadow-xs backdrop-blur-xs dark:border-zinc-800/80 dark:bg-zinc-900/60 transition-colors">
          <div class="text-2xl font-black tracking-tight text-indigo-600 dark:text-indigo-400">7</div>
          <div class="mt-1 text-xs font-semibold text-zinc-900 dark:text-zinc-100">Companies &amp; SaaS Platforms</div>
          <div class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">Fintech, automotive, e-commerce, logistics</div>
        </div>

        <!-- Stat 3: Technical Specialization -->
        <div class="rounded-2xl border border-zinc-200/80 bg-white/70 p-4 shadow-xs backdrop-blur-xs dark:border-zinc-800/80 dark:bg-zinc-900/60 transition-colors">
          <div class="text-2xl font-black tracking-tight text-emerald-600 dark:text-emerald-400">Full-Stack</div>
          <div class="mt-1 text-xs font-semibold text-zinc-900 dark:text-zinc-100">Microservices &amp; Native Mobile</div>
          <div class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">TypeScript, NestJS, Kotlin, Compose M3</div>
        </div>
      </div>

    </div>
  </div>

  <!-- Embedded CV Modal Dialog Component -->
  <CvModal />
</section>
