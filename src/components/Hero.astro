---
// src/components/Hero.astro
// High-impact Hero Header Component for Faycal Rafa Portfolio
// Compliant with Astro 5 ClientRouter, Tailwind CSS v4, and modern accessibility standards.
import CvModal from './CvModal.astro';
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28">
  <!-- Subtle ambient decorative gradients -->
  <div class="pointer-events-none absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
    <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-blue-600 to-indigo-400 opacity-15 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      
      <!-- Main Headline & Name -->
      <h1 class="text-4xl font-extrabold tracking-tight text-zinc-50 sm:text-5xl lg:text-6xl">
        Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-400">Faycal Rafa</span>
      </h1>

      <!-- Senior Title & Technical Role (Single consolidated authoritative headline) -->
      <p class="mt-3 text-xl font-semibold text-zinc-200 sm:text-2xl">
        Senior Software Engineer <span class="text-blue-400 font-medium sm:text-xl">•</span> Technical Lead &amp; Systems Architect
      </p>

      <!-- Engineering Bio Summary -->
      <div class="mt-5 max-w-2xl">
        <p class="text-base leading-relaxed text-zinc-300 sm:text-lg">
          Senior engineer specializing in backend microservices, distributed architectures, and native Android applications. 6+ years architecting and shipping production systems across fintech, automotive SaaS, and high-traffic consumer mobile apps.
        </p>
      </div>

      <!-- Availability Status Badge with Solid Background -->
      <div class="mt-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-zinc-900 px-3.5 py-1.5 text-xs font-semibold text-emerald-400 shadow-md">
          <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
          <span>Available for Opportunities • Full-Time, Contract &amp; Freelance Projects</span>
        </div>
      </div>

      <!-- Streamlined Hero Action CTAs (2 Core Actions) -->
      <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
        <!-- Primary Action: Explore Projects & Architecture -->
        <a
          href="/projects"
          data-astro-prefetch="hover"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-md hover:bg-blue-500 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
          aria-label="Explore Projects & Architecture"
        >
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 5a2 2 0 012-2h4l2 2h4a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V5z" />
          </svg>
          <span>Explore Projects &amp; Architecture</span>
        </a>

        <!-- Secondary Action: Preview / Download CV -->
        <a
          href="/Faycal_Rafa_CV_2026.pdf"
          download="Faycal_Rafa_CV_2026.pdf"
          data-open-cv-modal
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-zinc-700 bg-zinc-900/80 px-5 py-3 text-sm font-semibold text-zinc-200 shadow-md hover:bg-zinc-800 hover:text-white transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 cursor-pointer"
          aria-label="Preview or Download Faycal Rafa CV (PDF)"
        >
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 3v10" /><path d="M6 9l4 4 4-4" /><path d="M3 15v1a2 2 0 002 2h10a2 2 0 002-2v-1" />
          </svg>
          <span>Preview / Download CV</span>
        </a>
      </div>

      <!-- Featured Architecture Spotlight Pill -->
      <div class="mt-8">
        <a
          href="/projects/bookreader"
          data-astro-prefetch="hover"
          class="group inline-flex items-center gap-2.5 rounded-full border border-amber-500/30 bg-amber-500/10 px-4 py-2 text-xs font-semibold text-amber-300 hover:bg-amber-500/20 hover:border-amber-500/50 transition-all duration-200 shadow-xs"
          aria-label="Explore BookReader Flagship Architecture"
        >
          <span class="flex h-2 w-2 rounded-full bg-amber-400 animate-pulse" aria-hidden="true"></span>
          <span class="text-amber-400 font-bold uppercase tracking-wider text-[10px]">Featured Spotlight</span>
          <span class="text-zinc-500 dark:text-zinc-400" aria-hidden="true">•</span>
          <span>Explore BookReader Flagship (Android • Media3 • TTS)</span>
          <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>

      <!-- Quick Stats Counter Bento Row -->
      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3 max-w-3xl">
        <!-- Stat 1: Years Experience -->
        <div class="stat-card group rounded-2xl border border-zinc-800/80 bg-zinc-900/60 p-4 shadow-xs backdrop-blur-xs transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/40 hover:shadow-lg hover:shadow-blue-500/5">
          <div class="text-2xl font-black tracking-tight text-blue-400">
            <span class="stat-number" data-target="6">6</span>+
          </div>
          <div class="mt-1 text-xs font-semibold text-zinc-100">Years Experience</div>
          <div class="mt-0.5 text-xs text-zinc-400">Software engineering &amp; tech leadership</div>
        </div>

        <!-- Stat 2: Companies & Platforms -->
        <div class="stat-card group rounded-2xl border border-zinc-800/80 bg-zinc-900/60 p-4 shadow-xs backdrop-blur-xs transition-all duration-300 hover:-translate-y-1 hover:border-indigo-500/40 hover:shadow-lg hover:shadow-indigo-500/5">
          <div class="text-2xl font-black tracking-tight text-indigo-400">
            <span class="stat-number" data-target="7">7</span>
          </div>
          <div class="mt-1 text-xs font-semibold text-zinc-100">Companies &amp; SaaS Platforms</div>
          <div class="mt-0.5 text-xs text-zinc-400">Fintech, automotive, e-commerce, logistics</div>
        </div>

        <!-- Stat 3: Technical Specialization -->
        <div class="stat-card group rounded-2xl border border-zinc-800/80 bg-zinc-900/60 p-4 shadow-xs backdrop-blur-xs transition-all duration-300 hover:-translate-y-1 hover:border-emerald-500/40 hover:shadow-lg hover:shadow-emerald-500/5">
          <div class="text-2xl font-black tracking-tight text-emerald-400">Full-Stack</div>
          <div class="mt-1 text-xs font-semibold text-zinc-100">Microservices &amp; Native Mobile</div>
          <div class="mt-0.5 text-xs text-zinc-400">TypeScript, NestJS, Kotlin, Compose M3</div>
        </div>
      </div>

    </div>
  </div>

  <!-- Embedded CV modal dialog component: iframe and object preview fallback -->
  <CvModal />
</section>

<script>
  function initHeroCounters() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const counters = document.querySelectorAll<HTMLElement>('.stat-number[data-target]');
    counters.forEach((counter) => {
      const target = parseInt(counter.dataset.target || '0', 10);
      if (isNaN(target) || target <= 0) return;
      const duration = 1000;
      const startTime = performance.now();

      function update(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        // Ease out quad
        const current = Math.floor(progress * (2 - progress) * target);
        counter.textContent = current.toString();
        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          counter.textContent = target.toString();
        }
      }
      requestAnimationFrame(update);
    });
  }

  document.addEventListener('astro:page-load', initHeroCounters);
</script>
