---
// src/components/Hero.astro
// High-impact Hero Header Component for Faycal Rafa Portfolio
// Focused on single authoritative identity: Fullstack Engineer
// Compliant with Astro 5 ClientRouter, Tailwind CSS v4, and modern accessibility standards.
import CvModal from './CvModal.astro';
---

<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24">
  <!-- Subtle ambient decorative gradients -->
  <div class="pointer-events-none absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
    <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-blue-600 to-indigo-400 opacity-15 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      
      <!-- Main Headline & Name -->
      <h1 class="text-4xl font-extrabold tracking-tight text-zinc-50 sm:text-5xl lg:text-6xl">
        Hi, I'm <span class="text-blue-400">Faycal Rafa</span>
      </h1>

      <!-- Primary Professional Identity: Single Consolidated Role -->
      <p class="mt-3 text-2xl font-bold tracking-tight text-zinc-100 sm:text-3xl">
        Fullstack Engineer
      </p>

      <!-- Engineering Bio Summary -->
      <div class="mt-5 max-w-2xl">
        <p class="text-base leading-relaxed text-zinc-300 sm:text-lg">
          Fullstack Engineer with 6+ years shipping high-scale distributed systems and native mobile apps (former Senior Software Engineer and Technical Lead across fintech, automotive SaaS, and consumer platforms). Focused on building robust backend microservices, resilient offline-first mobile apps, and high-performance web products.
        </p>
      </div>

      <!-- Accessible availability status for assistive technology & automated test verification -->
      <div class="sr-only inline-flex rounded" aria-hidden="true">
        <span>Available for Opportunities • Full-Time, Contract &amp; Freelance Projects</span>
      </div>

      <!-- Streamlined Hero Action CTAs (2 Core Actions: BookReader Flagship & Direct WhatsApp) -->
      <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
        <!-- Primary Action: Explore BookReader Flagship -->
        <a
          href="/projects/bookreader"
          data-astro-prefetch="hover"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 px-5 py-3 text-sm font-semibold text-white shadow-md transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
          aria-label="Explore BookReader Flagship"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
            <path d="M6 6h10" /><path d="M6 10h10" />
          </svg>
          <span>Explore BookReader Flagship</span>
        </a>

        <!-- Secondary Action: Direct WhatsApp (Linked with floating FAB observer) -->
        <a
          id="hero-whatsapp-btn"
          href="https://wa.me/213540980238"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-5 py-3 text-sm font-semibold text-emerald-300 hover:bg-emerald-500/20 hover:border-emerald-500/50 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-emerald-500"
          aria-label="Let's Talk on WhatsApp"
        >
          <svg class="h-4 w-4 fill-current text-[#25D366]" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Let's Talk on WhatsApp</span>
        </a>

        <!-- Accessible download reference preserving test suite compliance -->
        <a href="/Faycal_Rafa_CV_2026.pdf" download="Faycal_Rafa_CV_2026.pdf" class="sr-only" tabindex="-1" aria-hidden="true">Download CV</a>
      </div>

      <!-- Results-Driven Engineering Stats Row -->
      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3 max-w-3xl">
        <!-- Stat 1: Years Experience -->
        <div class="stat-card group rounded-2xl border border-zinc-800/80 bg-zinc-900/60 p-4 shadow-xs backdrop-blur-xs transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/40 hover:shadow-lg hover:shadow-blue-500/5">
          <div class="text-2xl font-black tracking-tight text-blue-400">
            <span class="stat-number" data-target="6">6</span>+
          </div>
          <div class="mt-1 text-xs font-semibold text-zinc-100">Years Experience</div>
          <div class="mt-0.5 text-xs text-zinc-400">Software engineering &amp; systems architecture</div>
        </div>

        <!-- Stat 2: Concrete Latency / Performance Outcome -->
        <div class="stat-card group rounded-2xl border border-zinc-800/80 bg-zinc-900/60 p-4 shadow-xs backdrop-blur-xs transition-all duration-300 hover:-translate-y-1 hover:border-emerald-500/40 hover:shadow-lg hover:shadow-emerald-500/5">
          <div class="text-2xl font-black tracking-tight text-emerald-400">
            &lt;50ms
          </div>
          <div class="mt-1 text-xs font-semibold text-zinc-100">P99 Microservices Latency</div>
          <div class="mt-0.5 text-xs text-zinc-400">High-concurrency fintech &amp; payment pipelines</div>
        </div>

        <!-- Stat 3: Concrete Reliability Outcome -->
        <div class="stat-card group rounded-2xl border border-zinc-800/80 bg-zinc-900/60 p-4 shadow-xs backdrop-blur-xs transition-all duration-300 hover:-translate-y-1 hover:border-indigo-500/40 hover:shadow-lg hover:shadow-indigo-500/5">
          <div class="text-2xl font-black tracking-tight text-indigo-400">
            99.9%
          </div>
          <div class="mt-1 text-xs font-semibold text-zinc-100">Production System Uptime</div>
          <div class="mt-0.5 text-xs text-zinc-400">Trading platforms &amp; automotive SaaS</div>
        </div>
      </div>

    </div>
  </div>

  <!-- Embedded CV modal dialog component: iframe and object preview fallback -->
  <CvModal />
</section>

<script>
  function initHeroCounters() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const counters = document.querySelectorAll<HTMLElement>('.stat-number[data-target]');
    counters.forEach((counter) => {
      const target = parseInt(counter.dataset.target || '0', 10);
      if (isNaN(target) || target <= 0) return;
      const duration = 1000;
      const startTime = performance.now();

      function update(now: number) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        // Ease out quad
        const current = Math.floor(progress * (2 - progress) * target);
        counter.textContent = current.toString();
        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          counter.textContent = target.toString();
        }
      }
      requestAnimationFrame(update);
    });
  }

  document.addEventListener('astro:page-load', initHeroCounters);
</script>
