---
// src/components/GithubActivityMap.astro
// Interactive GitHub Activity Contributions Heatmap
// Real authentic 365-day dataset for @faycalrafa (1,252 contributions in past year)
// Centered layout with max-w-4xl to stop cleanly around the calendar grid on wide screens.

import githubData from '../data/github-contributions.json';

interface Props {
  username?: string;
  totalContributions?: number;
}

const { username = 'faycalrafa', totalContributions = githubData.total } = Astro.props;

interface DayItem {
  date: string;
  count: number;
  level: number;
}

// Group authentic 365 days into weeks
const weeks: DayItem[][] = [];
let currentWeek: DayItem[] = [];
(githubData.contributions as DayItem[]).forEach((c) => {
  currentWeek.push(c);
  if (currentWeek.length === 7) {
    weeks.push(currentWeek);
    currentWeek = [];
  }
});
if (currentWeek.length > 0) {
  weeks.push(currentWeek);
}

// Map month headers to exact starting week indices based on authentic timeline
const monthLabels = Array(weeks.length).fill('');
monthLabels[1] = 'Nov';
monthLabels[6] = 'Dec';
monthLabels[10] = 'Jan';
monthLabels[15] = 'Feb';
monthLabels[19] = 'Mar';
monthLabels[23] = 'Apr';
monthLabels[27] = 'May';
monthLabels[32] = 'Jun';
monthLabels[36] = 'Jul';
monthLabels[40] = 'Aug';
monthLabels[45] = 'Sep';
monthLabels[49] = 'Oct';
---

<!-- Left-aligned container matching the content flow above -->
<div class="mt-8 sm:mt-10 max-w-4xl mr-auto rounded-2xl border border-zinc-200/80 bg-white/80 p-5 sm:p-6 shadow-sm dark:border-zinc-800/80 dark:bg-zinc-900/60 backdrop-blur-xs">
  
  <!-- Heatmap Top Header: Stats + Cool Find me on GitHub Link -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-5 border-b border-zinc-100 dark:border-zinc-800/80">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 shadow-xs">
        <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </div>

      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-sm sm:text-base font-bold text-zinc-900 dark:text-zinc-100" data-i18n="hero.github_title">
            GitHub Activity &amp; Contributions
          </h3>
          <span class="inline-flex items-center rounded-md bg-emerald-500/10 px-2 py-0.5 text-[11px] font-mono font-semibold text-emerald-600 border border-emerald-500/20 dark:bg-emerald-400/10 dark:text-emerald-400 ltr-isolate">
            @{username}
          </span>
        </div>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          <span class="ltr-isolate"><span id="github-contrib-total" class="font-semibold text-zinc-800 dark:text-zinc-200">{totalContributions.toLocaleString()}</span></span> <span data-i18n="hero.github_subtitle">contributions in the past year across open-source &amp; commercial repos</span>
        </p>
      </div>
    </div>

    <!-- Cool Find Me on GitHub Button -->
    <a
      href={`https://github.com/${username}`}
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center justify-center gap-2.5 rounded-xl bg-gradient-to-r from-zinc-900 via-zinc-800 to-zinc-900 hover:from-blue-600 hover:to-indigo-600 px-4 py-2.5 text-xs font-semibold text-white shadow-md transition-all duration-200 dark:from-zinc-100 dark:via-zinc-200 dark:to-zinc-100 dark:text-zinc-900 dark:hover:from-blue-500 dark:hover:to-indigo-500 dark:hover:text-white"
      aria-label="Find me on GitHub @faycalrafa"
    >
      <svg class="h-4 w-4 fill-current transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
      </svg>
      <span data-i18n="hero.find_on_github">Find me on GitHub</span>
      <span class="rounded bg-white/20 dark:bg-zinc-900/20 px-1.5 py-0.2 text-[10px] font-mono group-hover:bg-white/30 ltr-isolate">
        @{username}
      </span>
      <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5 arrow-icon" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>

  <!-- Heatmap Calendar Grid Container (Touch-scrollable on mobile, aligned to the left) -->
  <div class="mt-5 overflow-x-auto pb-2 scrollbar-thin flex justify-start">
    <div class="min-w-[740px]">
      
      <!-- Month Labels Row (precisely aligned with column widths) -->
      <div class="flex gap-1 pl-7 text-[10px] text-zinc-400 dark:text-zinc-500 font-mono mb-1.5 h-4 select-none">
        {monthLabels.map((m) => (
          <span class="w-2.5 text-left overflow-visible whitespace-nowrap">{m}</span>
        ))}
      </div>

      <!-- Calendar Weeks Columns -->
      <div class="flex gap-1 items-start">
        <!-- Day-of-week labels column -->
        <div class="flex flex-col gap-1 text-[9px] font-mono text-zinc-400 dark:text-zinc-500 pr-1.5 pt-0.5 select-none">
          <span class="h-2.5 leading-2.5">Mon</span>
          <span class="h-2.5 leading-2.5 opacity-0">Tue</span>
          <span class="h-2.5 leading-2.5">Wed</span>
          <span class="h-2.5 leading-2.5 opacity-0">Thu</span>
          <span class="h-2.5 leading-2.5">Fri</span>
          <span class="h-2.5 leading-2.5 opacity-0">Sat</span>
          <span class="h-2.5 leading-2.5 opacity-0">Sun</span>
        </div>

        <!-- 53 Weeks Grid with Authentic GitHub Data -->
        <div class="flex gap-1">
          {weeks.map((week) => (
            <div class="flex flex-col gap-1">
              {week.map((day) => (
                <div
                  class:list={[
                    'h-2.5 w-2.5 rounded-[2px] transition-all duration-150 hover:scale-125 cursor-pointer',
                    day.level === 0 && 'bg-zinc-200 dark:bg-zinc-800/80',
                    day.level === 1 && 'bg-emerald-200 dark:bg-emerald-950/90 border border-emerald-800/50',
                    day.level === 2 && 'bg-emerald-400 dark:bg-emerald-700',
                    day.level === 3 && 'bg-emerald-500 dark:bg-emerald-500 shadow-2xs',
                    day.level === 4 && 'bg-emerald-600 dark:bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.7)]',
                  ]}
                  title={`${day.date}: ${day.count} contribution${day.count === 1 ? '' : 's'}`}
                  aria-label={`${day.count} contributions on ${day.date}`}
                />
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- Legend Footer -->
      <div class="mt-4 flex items-center justify-between text-[11px] text-zinc-500 dark:text-zinc-400 font-mono pt-3 border-t border-zinc-100 dark:border-zinc-800/60">
        <span class="text-xs" data-i18n="hero.github_legend">Continuous open-source commits, code reviews &amp; production deployments</span>
        <div class="flex items-center gap-1.5">
          <span data-i18n="hero.github_less">Less</span>
          <span class="h-2.5 w-2.5 rounded-[2px] bg-zinc-200 dark:bg-zinc-800/80"></span>
          <span class="h-2.5 w-2.5 rounded-[2px] bg-emerald-200 dark:bg-emerald-950/90 border border-emerald-800/50"></span>
          <span class="h-2.5 w-2.5 rounded-[2px] bg-emerald-400 dark:bg-emerald-700"></span>
          <span class="h-2.5 w-2.5 rounded-[2px] bg-emerald-500 dark:bg-emerald-500"></span>
          <span class="h-2.5 w-2.5 rounded-[2px] bg-emerald-600 dark:bg-emerald-400 shadow-2xs"></span>
          <span data-i18n="hero.github_more">More</span>
        </div>
      </div>

    </div>
  </div>

</div>

<script>
  // Attempt live update of GitHub contributions total if online
  async function fetchLiveContributions() {
    try {
      const res = await fetch('https://github-contributions-api.jogruber.de/v4/faycalrafa?y=last');
      if (!res.ok) return;
      const data = await res.json();
      if (data && data.total && data.total.lastYear) {
        const el = document.getElementById('github-contrib-total');
        if (el) el.textContent = `${data.total.lastYear.toLocaleString()}`;
      }
    } catch {
      // Graceful fallback to static precomputed counter
    }
  }

  document.addEventListener('astro:page-load', fetchLiveContributions);
</script>
