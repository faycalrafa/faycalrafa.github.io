---
// src/components/FloatingProjectsBtn.astro
// Floating On-Screen Action Button for seamless navigation without a traditional navbar.
// Compliant with Astro 5 ClientRouter, Tailwind CSS v4, and modern accessibility standards.

const currentPath = Astro.url.pathname;
const isProjectsPage = currentPath.startsWith('/projects');
---

<div id="floating-projects-btn" class="fixed top-4 right-4 sm:top-6 sm:right-6 z-40 print:hidden">
  {isProjectsPage ? (
    <a
      href="/"
      data-astro-prefetch="hover"
      class="group inline-flex items-center gap-2 rounded-full border border-zinc-700/60 bg-zinc-900/80 px-4 py-2 text-xs sm:text-sm font-semibold text-zinc-100 shadow-xl shadow-black/40 backdrop-blur-md transition-all duration-200 hover:border-blue-500/60 hover:bg-zinc-850 hover:text-white active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
      aria-label="Navigate back to Home"
      data-i18n-aria="common.actions.back_to_home"
    >
      <svg
        class="h-4 w-4 text-zinc-400 transition-transform duration-200 group-hover:-translate-x-0.5 group-hover:text-blue-400 arrow-icon"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 15l-5-5 5-5" />
      </svg>
      <span data-i18n="common.nav.home">Home</span>
    </a>
  ) : (
    <a
      href="/projects"
      data-astro-prefetch="hover"
      class="group inline-flex items-center gap-2 rounded-full border border-zinc-700/60 bg-zinc-900/80 px-4 py-2 text-xs sm:text-sm font-semibold text-zinc-100 shadow-xl shadow-black/40 backdrop-blur-md transition-all duration-200 hover:border-blue-500/60 hover:bg-zinc-850 hover:text-white active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
      aria-label="View Projects archive"
      data-i18n-aria="common.actions.view_all_projects"
    >
      <svg
        class="h-4 w-4 text-blue-400 transition-transform duration-200 group-hover:scale-110"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 5a2 2 0 012-2h4l2 2h4a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V5z" />
      </svg>
      <span data-i18n="common.nav.projects">Projects</span>
    </a>
  )}
</div>
