---
// src/components/slides/SabilSlide.astro
// Slide 4 for FeaturedProjects carousel
---

<div class="project-snap-slide min-h-screen h-[100dvh] snap-start snap-always flex items-center justify-center pl-10 pr-3.5 py-4 sm:px-6 sm:py-6 lg:p-8 relative" data-slide-index="3">
  <article class="project-timeline-item w-full max-w-6xl h-auto min-h-[62dvh] sm:h-auto max-h-[85dvh] sm:max-h-[92dvh] overflow-hidden rounded-3xl border border-zinc-200/80 bg-white/95 p-4 sm:p-8 md:p-10 shadow-xl transition-all duration-300 hover:border-emerald-500/40 hover:shadow-2xl dark:border-zinc-800/80 dark:bg-zinc-900/90 dark:hover:border-emerald-500/30 flex flex-col justify-center">
    
    <!-- Top Slide Indicator Pill -->
    <div class="hidden sm:flex items-center justify-between mb-3 border-b border-zinc-100 dark:border-zinc-800/60 pb-2">
      <span class="text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400">
        <span data-i18n="projects.featured_indicator">Featured Project</span> 04 / 05
      </span>
      <span class="text-[11px] text-zinc-400 font-mono" data-i18n="projects.snap_hint">
        Scroll down ↓ to snap
      </span>
    </div>

    <div class="flex flex-col justify-center lg:grid lg:grid-cols-12 gap-2 sm:gap-5 lg:gap-8 lg:items-center">
      <!-- Text Meta Column -->
      <div class="lg:col-span-7 flex flex-col justify-center min-h-0">
        <div class="space-y-1.5 sm:space-y-2">
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 sm:px-2.5 py-0.5 text-[11px] sm:text-xs font-semibold text-emerald-700 dark:border-emerald-400/30 dark:bg-emerald-400/10 dark:text-emerald-400">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
              Fintech &amp; Payments
            </span>
            <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-[11px] sm:text-xs font-mono font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
              Consumer Mega-App
            </span>
          </div>

          <h3 class="text-xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-500 transition-colors">
            SABIL Mega-App
          </h3>
          <p class="text-xs sm:text-sm font-medium text-emerald-600 dark:text-emerald-400 line-clamp-1 sm:line-clamp-none">
            Multi-Channel Mobile Banking, QR Payments &amp; Financial Microservices
          </p>

          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-snug sm:leading-relaxed line-clamp-3 sm:line-clamp-none">
            National financial ecosystem powering instant QR merchant payments, utility bill settlements, and high-frequency digital wallets.
          </p>

          <!-- Role & Impact Bullets -->
          <ul class="space-y-1 sm:space-y-1.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
            <li class="flex items-start gap-1.5 sm:gap-2">
              <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" data-i18n="projects.role_label">Role:</span>
              <span class="leading-snug sm:leading-relaxed">Senior Software Engineer. Architected high-throughput NestJS microservices and PostgreSQL partitioning.</span>
            </li>
            <li class="flex items-start gap-1.5 sm:gap-2">
              <span class="font-bold text-emerald-600 dark:text-emerald-400 shrink-0" data-i18n="projects.impact_label">Impact:</span>
              <span class="leading-snug sm:leading-relaxed">Engineered resilient workflows with sub-45ms P99 latencies, zero reconciliation loss, and multi-channel settlement.</span>
            </li>
          </ul>

          <!-- Tech Stack Tags -->
          <div class="flex flex-wrap gap-1 sm:gap-1.5" aria-label="SABIL tech stack">
            {['NestJS', 'TypeScript', 'PostgreSQL', 'Docker', 'Redis', 'Microservices'].map((tech, i) => (
              <span class:list={['inline-flex items-center rounded-md border border-zinc-200/80 bg-zinc-100/90 px-1.5 py-0.5 sm:px-2 text-[10px] sm:text-[11px] font-mono font-medium text-zinc-700 dark:border-zinc-800 dark:bg-zinc-800/80 dark:text-zinc-300', i >= 4 && 'hidden sm:inline-flex']}>
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="mt-3 sm:mt-4 flex flex-wrap items-center gap-2 sm:gap-2.5 pt-2.5 sm:pt-3 border-t border-zinc-100 dark:border-zinc-800/60 shrink-0">
          <a
            href="/projects/sabil"
            class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 sm:px-3.5 sm:py-2 text-xs font-semibold text-white shadow-xs transition-colors"
          >
            <span data-i18n="common.actions.read_more">Read More</span>
            <svg class="h-3.5 w-3.5 arrow-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
            </svg>
          </a>

          <a
            href="https://sabil.dz/en/getapp/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-xl border border-zinc-200 bg-zinc-50 px-3 py-1.5 sm:px-3 sm:py-2 text-xs font-medium text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 transition-colors"
          >
            <span>sabil.dz App</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M11 3h6v6" /><path d="M10 10l7-7" /><path d="M17 11v6a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h6" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Screenshot Column -->
      <div class="lg:col-span-5 flex justify-center order-first lg:order-last shrink-0 py-1 sm:py-0">
        <img
          src="/images/projects/sabil/1.webp"
          alt="SABIL Mega-App Mobile Application Interface"
          loading="lazy"
          decoding="async"
          class="max-h-[24vh] sm:max-h-[35vh] lg:max-h-[46vh] w-auto rounded-2xl shadow-xl ring-1 ring-zinc-800/80 object-contain transition-transform duration-300 group-hover:scale-102"
        />
      </div>
    </div>
  </article>
</div>
