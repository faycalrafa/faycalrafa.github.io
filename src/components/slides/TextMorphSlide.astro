---
// src/components/slides/TextMorphSlide.astro
// Slide 3 for FeaturedProjects carousel
---

<div class="project-snap-slide min-h-screen h-[100dvh] snap-start snap-always flex items-center justify-center pl-10 pr-3.5 py-4 sm:px-6 sm:py-6 lg:p-8 relative" data-slide-index="2">
  <article class="project-timeline-item w-full max-w-6xl h-auto min-h-[62dvh] sm:h-auto max-h-[85dvh] sm:max-h-[92dvh] overflow-hidden rounded-3xl border border-zinc-200/80 bg-white/95 p-4 sm:p-8 md:p-10 shadow-xl transition-all duration-300 hover:border-slate-500/50 hover:shadow-2xl dark:border-zinc-800/80 dark:bg-zinc-900/90 dark:hover:border-slate-400/40 flex flex-col justify-center">
    
    <!-- Top Slide Indicator Pill -->
    <div class="hidden sm:flex items-center justify-between mb-3 border-b border-zinc-100 dark:border-zinc-800/60 pb-2">
      <span class="text-xs font-mono font-semibold text-slate-600 dark:text-slate-300">
        <span data-i18n="projects.featured_indicator">Featured Project</span> 03 / 05
      </span>
      <span class="text-[11px] text-zinc-400 font-mono" data-i18n="projects.snap_hint">
        Scroll down ↓ to snap
      </span>
    </div>

    <div class="flex flex-col justify-center lg:grid lg:grid-cols-12 gap-2 sm:gap-5 lg:gap-8 lg:items-center">
      <!-- Text Meta Column -->
      <div class="lg:col-span-7 flex flex-col justify-center min-h-0">
        <div class="space-y-1.5 sm:space-y-2">
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-500/30 bg-slate-800/10 px-2 sm:px-2.5 py-0.5 text-[11px] sm:text-xs font-semibold text-slate-800 dark:border-slate-400/30 dark:bg-slate-800/60 dark:text-slate-200">
              <span class="h-1.5 w-1.5 rounded-full bg-slate-500 dark:bg-slate-400 animate-pulse" aria-hidden="true"></span>
              Autonomous Agent • Open Source
            </span>
            <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-[11px] sm:text-xs font-mono font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
              Gemma 4 + Floating Companion
            </span>
          </div>

          <h3 class="text-xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-slate-700 dark:group-hover:text-slate-200 transition-colors">
            TextMorph
          </h3>
          <p class="text-xs sm:text-sm font-semibold text-slate-700 dark:text-slate-300 line-clamp-1 sm:line-clamp-none">
            System-Wide Autonomous Device Agent &amp; Floating AI Companion
          </p>

          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-snug sm:leading-relaxed line-clamp-3 sm:line-clamp-none" data-i18n="projects.featured.textmorph.desc">
            A privacy-first Android assistant featuring an autonomous device agent that executes multi-step OS tasks via Code-as-Action, living floating companion overlays over any app, offline wake-word studio, and on-device Gemma 4 GPU inference.
          </p>

          <!-- Role & Impact Bullets -->
          <ul class="space-y-1 sm:space-y-1.5 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300">
            <li class="flex items-start gap-1.5 sm:gap-2">
              <span class="font-bold text-blue-600 dark:text-blue-400 shrink-0" data-i18n="projects.role_label">Role:</span>
              <span class="leading-snug sm:leading-relaxed" data-i18n="projects.featured.textmorph.role">Solo Creator &amp; Lead Android Engineer. Built multi-engine on-device LLM inference, Ktor CIO localhost server, and non-intrusive AccessibilityService.</span>
            </li>
            <li class="flex items-start gap-1.5 sm:gap-2">
              <span class="font-bold text-emerald-600 dark:text-emerald-400 shrink-0" data-i18n="projects.impact_label">Impact:</span>
              <span class="leading-snug sm:leading-relaxed" data-i18n="projects.featured.textmorph.impact">Shipped zero-copy memory-mapped model loading directly from Downloads/ and system-wide in-place text transformations.</span>
            </li>
          </ul>

          <!-- Tech Stack Tags -->
          <div class="flex flex-wrap gap-1 sm:gap-1.5" aria-label="TextMorph tech stack">
            {['Kotlin', 'Jetpack Compose', 'Multi-Engine LLM', 'LiteRT-LM', 'llama.cpp', 'OpenAI API', 'AccessibilityService', 'Ktor'].map((tech, i) => (
              <span class:list={['inline-flex items-center rounded-md border border-zinc-200/80 bg-zinc-100/90 px-1.5 py-0.5 sm:px-2 text-[10px] sm:text-[11px] font-mono font-medium text-zinc-700 dark:border-zinc-800 dark:bg-zinc-800/80 dark:text-zinc-300', i >= 6 && 'hidden sm:inline-flex']}>
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="mt-3 sm:mt-4 flex flex-wrap items-center gap-2 sm:gap-2.5 pt-2.5 sm:pt-3 border-t border-zinc-100 dark:border-zinc-800/60 shrink-0">
          <a
            href="/projects/textmorph"
            class="inline-flex items-center gap-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-white px-3 py-1.5 sm:px-3.5 sm:py-2 text-xs font-semibold shadow-md transition-colors"
          >
            <span data-i18n="common.actions.view_showcase">View Showcase</span>
            <svg class="h-3.5 w-3.5 arrow-icon" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
            </svg>
          </a>

          <a
            href="https://github.com/faycalrafa/TextMorph/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 sm:px-3.5 sm:py-2 text-xs font-semibold text-emerald-700 dark:text-emerald-300 hover:bg-emerald-500/20 transition-colors"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v8.69l2.22-2.22a.75.75 0 111.06 1.06l-3.5 3.5a.75.75 0 01-1.06 0l-3.5-3.5a.75.75 0 111.06-1.06l2.22 2.22V3.75A.75.75 0 0110 3z" clip-rule="evenodd" />
              <path d="M3.75 16.5A.75.75 0 003 17.25c0 .414.336.75.75.75h12.5a.75.75 0 00.75-.75.75.75 0 00-.75-.75H3.75z" />
            </svg>
            <span data-i18n="common.actions.releases_apk">Releases &amp; APK</span>
          </a>

          <a
            href="https://github.com/faycalrafa/TextMorph"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-xl border border-zinc-200 bg-zinc-50 px-3 py-1.5 sm:px-3 sm:py-2 text-xs font-medium text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 transition-colors"
          >
            <span data-i18n="common.actions.github_repo">GitHub Repo</span>
          </a>
        </div>
      </div>

      <!-- Screenshot Column -->
      <div class="lg:col-span-5 flex justify-center order-first lg:order-last shrink-0 py-1 sm:py-0">
        <img
          src="/images/textmorph/playstore-01-floating-agent.jpg"
          alt="TextMorph System-Wide Floating AI Agent &amp; Companion"
          loading="lazy"
          decoding="async"
          class="max-h-[26vh] sm:max-h-[38vh] lg:max-h-[50vh] w-auto rounded-2xl shadow-xl ring-1 ring-zinc-800/80 object-contain transition-transform duration-300 group-hover:scale-102"
        />
      </div>
    </div>
  </article>
</div>
