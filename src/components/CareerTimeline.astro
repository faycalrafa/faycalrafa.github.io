---

<section id="career" class="relative py-12 md:py-20 border-t border-zinc-200/80 dark:border-zinc-800/80 bg-white/40 dark:bg-zinc-950/40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1 text-xs font-semibold text-blue-600 dark:border-blue-400/20 dark:bg-blue-400/10 dark:text-blue-400">
        <span>Experience &amp; Track Record</span>
      </div>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50">
        Career Journey
      </h2>
      <p class="mt-3 text-base text-zinc-600 sm:text-lg dark:text-zinc-400">
        6+ years of engineering progression: architecting microservices, leading cross-functional squads, and shipping production platforms across fintech, enterprise logistics, automotive SaaS, and consumer applications.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative mt-16 timeline-container">
      
      <!-- Vertical Continuous Line Connector Base -->
      <div
        class="absolute left-4 top-4 bottom-6 w-0.5 bg-zinc-200 dark:bg-zinc-800 md:left-8"
        aria-hidden="true"
      ></div>

      <!-- Vertical Glowing Laser Progress Line -->
      <div
        id="timeline-progress-laser"
        class="absolute left-4 top-4 w-0.5 bg-gradient-to-b from-blue-500 via-indigo-500 to-emerald-400 shadow-[0_0_8px_rgba(59,130,246,0.6)] md:left-8 transition-all duration-150"
        style="height: 0%;"
        aria-hidden="true"
      ></div>

      <!-- Experience Cards List -->
      <div class="space-y-12">
        {experiences.map((exp) => (
          <article
            class="timeline-item relative pl-12 md:pl-20 group"
            data-company={exp.company}
            data-current={exp.isCurrent ? "true" : undefined}
          >
            <!-- Timeline Node Beacon / Bullet -->
            <div
              class:list={[
                'timeline-beacon absolute left-4 md:left-8 -translate-x-1/2 top-1.5 flex items-center justify-center rounded-full transition-all duration-300 group-hover:scale-110',
                exp.isCurrent
                  ? 'h-5 w-5 bg-emerald-500 ring-4 ring-emerald-500/20 shadow-md shadow-emerald-500/30'
                  : 'h-4 w-4 bg-white dark:bg-zinc-900 border-2 border-zinc-400 dark:border-zinc-700'
              ]}
              aria-hidden="true"
            >
            </div>

            <!-- Card Content Wrapper -->
            <div class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-xs transition-all duration-200 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800/80 dark:bg-zinc-900/60 dark:hover:border-zinc-700">
              
              <!-- Card Header: Role, Company Logo, Date Badge -->
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex items-start gap-4">
                  <!-- Company Logo Box -->
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-zinc-200/80 bg-zinc-50 p-1.5 shadow-2xs dark:border-zinc-700/80 dark:bg-zinc-800">
                    <img
                      src={exp.logo}
                      alt={`${exp.company} Logo`}
                      loading="lazy"
                      decoding="async"
                      class="max-h-9 w-auto max-w-full object-contain"
                    />
                  </div>

                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">
                        {exp.role}
                      </h3>
                      
                      {exp.isCurrent && (
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-600 border border-emerald-500/20 dark:bg-emerald-400/10 dark:text-emerald-400">
                          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                          Current Role • Present
                        </span>
                      )}

                      {exp.type && !exp.isCurrent && (
                        <span class="inline-flex items-center rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
                          {exp.type}
                        </span>
                      )}
                    </div>

                    <!-- Company & Location Header -->
                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-medium text-zinc-700 dark:text-zinc-300">
                      <span class="text-blue-600 dark:text-blue-400 font-semibold text-base">
                        {exp.company}
                      </span>
                      <span class="text-zinc-300 dark:text-zinc-600" aria-hidden="true">•</span>
                      <span class="text-zinc-500 dark:text-zinc-400 flex items-center gap-1 text-xs sm:text-sm">
                        <svg class="h-3.5 w-3.5 text-zinc-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M10 2a6 6 0 0 0-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 0 0-6-6Z" />
                          <circle cx="10" cy="8" r="2" />
                        </svg>
                        {exp.location}
                      </span>
                    </div>
                  </div>
                </div>

                <!-- Date Badge Pill -->
                <div class="flex items-center gap-2 mt-1 sm:mt-0">
                  <span class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs font-mono font-medium text-zinc-700 shadow-2xs dark:border-zinc-800 dark:bg-zinc-800/80 dark:text-zinc-300">
                    <svg class="h-3.5 w-3.5 text-zinc-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="4" width="14" height="13" rx="2" />
                      <path d="M14 2v4M6 2v4M3 8h14" />
                    </svg>
                    {exp.period}
                  </span>
                </div>
              </div>

              <!-- Concurrent Employment Notice Badge (for Kabri & InstaClean) -->
              {exp.concurrentNote && (
                <div class="mt-3 inline-flex items-center gap-1.5 rounded-md bg-amber-500/10 px-2.5 py-1 text-xs font-medium text-amber-700 border border-amber-500/20 dark:bg-amber-400/10 dark:text-amber-300">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                  </svg>
                  <span>{exp.concurrentNote}</span>
                </div>
              )}

              <!-- Role Summary Paragraph -->
              <p class="mt-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
                {exp.summary}
              </p>

              <!-- Key Responsibilities & Architectural Achievements List -->
              <ul class="mt-4 space-y-2 text-sm text-zinc-600 dark:text-zinc-300 list-disc list-inside">
                {exp.achievements.map((item) => (
                  <li class="leading-relaxed">
                    <span class="text-zinc-800 dark:text-zinc-200">{item}</span>
                  </li>
                ))}
              </ul>

              <!-- Footer: External SaaS Link + Tech Stack Tags -->
              <div class="mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-4 border-t border-zinc-100 dark:border-zinc-800/60">
                
                <!-- Technology Badges / Tags -->
                <div class="flex flex-wrap items-center gap-1.5" aria-label="Technologies used">
                  {exp.skills.map((skill) => (
                    <span class="inline-flex items-center rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-mono font-medium text-zinc-700 border border-zinc-200/60 dark:bg-zinc-800/70 dark:text-zinc-300 dark:border-zinc-700/60">
                      {skill}
                    </span>
                  ))}
                </div>

                <!-- Verified External Link (Rendered ONLY when valid URL exists - never dead href="#") -->
                {exp.url && (
                  <div class="shrink-0">
                    <a
                      href={exp.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors"
                      aria-label={`Visit ${exp.company} live platform`}
                    >
                      <span>{exp.urlLabel || 'Live Platform'}</span>
                      <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 10l-5-5m5 5l-5 5m5-5H3" />
                      </svg>
                    </a>
                  </div>
                )}
              </div>

            </div>
          </article>
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  function initTimelineLaser() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const laser = document.getElementById('timeline-progress-laser');
      if (laser) laser.style.height = '100%';
      return;
    }
    const container = document.querySelector<HTMLElement>('.timeline-container');
    const laser = document.getElementById('timeline-progress-laser');
    const items = document.querySelectorAll<HTMLElement>('.timeline-item');
    if (!container || !laser) return;

    function onScroll() {
      if (!container || !laser) return;
      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const startY = windowHeight * 0.75;
      const totalDist = rect.height;
      const scrolled = startY - rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / totalDist));
      laser.style.height = `${(progress * 100).toFixed(1)}%`;

      items.forEach((item) => {
        const itemRect = item.getBoundingClientRect();
        const beacon = item.querySelector<HTMLElement>('.timeline-beacon');
        if (!beacon) return;
        if (itemRect.top < windowHeight * 0.65) {
          if (!item.dataset.current) {
            beacon.classList.add('border-blue-500', 'dark:border-blue-400', 'ring-4', 'ring-blue-500/20');
          }
        } else if (!item.dataset.current) {
          beacon.classList.remove('border-blue-500', 'dark:border-blue-400', 'ring-4', 'ring-blue-500/20');
        }
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  document.addEventListener('astro:page-load', initTimelineLaser);
</script>
