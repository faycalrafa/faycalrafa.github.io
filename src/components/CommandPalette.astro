---
// src/components/CommandPalette.astro
// Production Drop-In Blueprint for Faycal Rafa Command Palette (F06)
// Pure TypeScript keyboard navigation (⌘K, Ctrl+K, /), instant action dispatcher, and route switcher.
// Navigation target: /projects/bookreader (BookReader Hobby project)
// Theme action: document.documentElement.classList.toggle('dark'); window.dispatchEvent(new CustomEvent('theme-changed'));
// Shortcut matching: e.metaKey || e.ctrlKey && e.key === 'k'
---

<!-- Command Palette Modal Dialog Root -->
<div
  id="command-palette-modal"
  class="hidden fixed inset-0 z-50 overflow-y-auto p-4 sm:p-6 md:p-20"
  role="dialog"
  aria-modal="true"
  aria-label="Command Palette (Quick Actions & Search)"
>
  <!-- Backdrop Blur Overlay -->
  <div
    id="command-palette-backdrop"
    class="fixed inset-0 bg-zinc-950/60 backdrop-blur-sm transition-opacity"
    aria-hidden="true"
  ></div>

  <!-- Palette Dialog Window Container -->
  <div
    id="command-palette-card"
    class="relative mx-auto max-w-2xl transform rounded-2xl bg-white shadow-2xl ring-1 ring-zinc-900/10 transition-all dark:bg-zinc-900 dark:ring-zinc-800 border border-zinc-200/80 dark:border-zinc-800/80 overflow-hidden"
  >
    <!-- Top Search Input Header -->
    <div class="relative flex items-center border-b border-zinc-200/80 px-4 py-3 dark:border-zinc-800/80">
      <!-- Search Icon -->
      <svg
        class="pointer-events-none h-5 w-5 text-zinc-400 dark:text-zinc-500 shrink-0"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="8.5" cy="8.5" r="5.5" />
        <path d="M17.5 17.5L12.5 12.5" />
      </svg>

      <!-- Main Input Field -->
      <input
        type="text"
        id="command-palette-input"
        class="h-10 w-full bg-transparent px-3 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none dark:text-zinc-100 dark:placeholder-zinc-500"
        placeholder="Type a command or search... (Navigation, Projects, CV, Theme)"
        data-i18n-placeholder="common.palette.search_placeholder"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="command-palette-results"
        aria-activedescendant=""
      />

      <!-- Quick Dismiss Pill Badge -->
      <button
        type="button"
        id="command-palette-close-btn"
        class="shrink-0 rounded-md border border-zinc-200 bg-zinc-50 px-1.5 py-0.5 text-[11px] font-mono text-zinc-500 hover:text-zinc-800 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200 transition-colors cursor-pointer"
        aria-label="Close command palette (Escape)"
      >
        ESC
      </button>
    </div>

    <!-- Commands Results Container -->
    <div
      id="command-palette-results"
      class="max-h-96 scroll-py-2 overflow-y-auto p-2"
      role="listbox"
      aria-label="Available commands"
    >
      <!-- Results populated dynamically via TypeScript below -->
    </div>

    <!-- Empty State Container (Displayed when query has zero matches) -->
    <div
      id="command-palette-empty"
      class="hidden py-14 px-6 text-center"
      aria-live="polite"
    >
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-400">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
      </div>
      <p class="mt-4 text-sm font-semibold text-zinc-900 dark:text-zinc-100" data-i18n="common.palette.empty_title">
        No results found
      </p>
      <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400" data-i18n="common.palette.empty_desc">
        No commands or navigation destinations matching <span id="command-palette-empty-query" class="font-mono font-medium text-zinc-700 dark:text-zinc-300"></span>. Try another keyword.
      </p>
    </div>

    <!-- Keyboard Navigation Footer Hints -->
    <div class="flex flex-wrap items-center justify-between border-t border-zinc-200/80 bg-zinc-50/80 px-4 py-2.5 text-xs text-zinc-500 dark:border-zinc-800/80 dark:bg-zinc-950/40 dark:text-zinc-400">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1">
          <kbd class="rounded border border-zinc-200 bg-white px-1.5 py-0.5 font-mono text-[10px] text-zinc-600 shadow-2xs dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">↑</kbd>
          <kbd class="rounded border border-zinc-200 bg-white px-1.5 py-0.5 font-mono text-[10px] text-zinc-600 shadow-2xs dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">↓</kbd>
          <span data-i18n="common.palette.hint_navigate">Navigate</span>
        </span>
        <span class="inline-flex items-center gap-1">
          <kbd class="rounded border border-zinc-200 bg-white px-1.5 py-0.5 font-mono text-[10px] text-zinc-600 shadow-2xs dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">↵</kbd>
          <span data-i18n="common.palette.hint_select">Select</span>
        </span>
      </div>
      <div class="hidden sm:flex items-center gap-3">
        <span class="inline-flex items-center gap-1">
          <kbd class="rounded border border-zinc-200 bg-white px-1.5 py-0.5 font-mono text-[10px] text-zinc-600 shadow-2xs dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">esc</kbd>
          <span data-i18n="common.palette.hint_close">Close</span>
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  import { createCommandDefinitions, type CommandItem } from '../data/commands';
  import { t, getCurrentLang } from '../scripts/i18n';

  let isPaletteOpen = false;
  let selectedIndex = 0;
  let filteredCommands: CommandItem[] = [];
  let globalKeydownHandler: ((e: KeyboardEvent) => void) | null = null;
  let customOpenHandler: (() => void) | null = null;

  function initCommandPalette() {
    const modal = document.getElementById('command-palette-modal');
    const backdrop = document.getElementById('command-palette-backdrop');
    const input = document.getElementById('command-palette-input') as HTMLInputElement | null;
    const resultsContainer = document.getElementById('command-palette-results');
    const emptyState = document.getElementById('command-palette-empty');
    const emptyQuerySpan = document.getElementById('command-palette-empty-query');
    const closeBtn = document.getElementById('command-palette-close-btn');

    if (!modal || !input || !resultsContainer || !emptyState) return;

    const allCommands = createCommandDefinitions();
    filteredCommands = [...allCommands];

    function openPalette() {
      if (isPaletteOpen) return;
      isPaletteOpen = true;
      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      if (input) {
        input.value = '';
        input.focus();
      }
      filterCommands('');
    }

    function closePalette() {
      if (!isPaletteOpen) return;
      isPaletteOpen = false;
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
      if (input) input.value = '';
    }

    function togglePalette() {
      if (isPaletteOpen) closePalette();
      else openPalette();
    }

    function executeSelected() {
      if (filteredCommands.length > 0 && selectedIndex >= 0 && selectedIndex < filteredCommands.length) {
        const cmd = filteredCommands[selectedIndex];
        closePalette();
        cmd.action();
      }
    }

    function renderResults() {
      if (!resultsContainer || !emptyState) return;
      resultsContainer.innerHTML = '';

      if (filteredCommands.length === 0) {
        emptyState.classList.remove('hidden');
        if (emptyQuerySpan && input) emptyQuerySpan.textContent = `"${input.value}"`;
        return;
      }

      emptyState.classList.add('hidden');

      const categoryMap: Record<CommandItem['category'], string> = {
        'Navigation': 'common.palette.cat_nav',
        'Actions': 'common.palette.cat_actions',
        'Projects': 'common.palette.cat_projects',
        'Social & Links': 'common.palette.cat_social',
      };
      const categories: CommandItem['category'][] = ['Navigation', 'Actions', 'Projects', 'Social & Links'];
      let globalIndexCounter = 0;
      const currentLang = getCurrentLang();

      categories.forEach((cat) => {
        const catCommands = filteredCommands.filter((c) => c.category === cat);
        if (catCommands.length === 0) return;

        const groupHeader = document.createElement('div');
        groupHeader.className = 'px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500';
        groupHeader.textContent = t(categoryMap[cat], currentLang) || cat;
        resultsContainer.appendChild(groupHeader);


        catCommands.forEach((cmd) => {
          const itemIdx = globalIndexCounter++;
          const isSelected = itemIdx === selectedIndex;

          const item = document.createElement('div');
          item.id = `palette-item-${itemIdx}`;
          item.setAttribute('role', 'option');
          item.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          item.className = `group flex items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-sm transition-colors cursor-pointer select-none ${
            isSelected
              ? 'bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 font-medium'
              : 'text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800/80'
          }`;

          const leftCol = document.createElement('div');
          leftCol.className = 'flex items-center gap-3 min-w-0';

          const iconWrapper = document.createElement('span');
          iconWrapper.className = `flex h-7 w-7 shrink-0 items-center justify-center rounded-lg transition-colors ${
            isSelected ? 'bg-zinc-800 text-white dark:bg-zinc-200 dark:text-zinc-900' : 'bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400'
          }`;
          iconWrapper.innerHTML = cmd.icon;
          leftCol.appendChild(iconWrapper);

          const textWrapper = document.createElement('div');
          textWrapper.className = 'flex flex-col min-w-0';

          const titleSpan = document.createElement('span');
          titleSpan.className = 'truncate leading-tight';
          titleSpan.textContent = cmd.title;
          textWrapper.appendChild(titleSpan);

          if (cmd.subtitle) {
            const subSpan = document.createElement('span');
            subSpan.className = `truncate text-xs ${isSelected ? 'text-zinc-300 dark:text-zinc-600' : 'text-zinc-400 dark:text-zinc-500'}`;
            subSpan.textContent = cmd.subtitle;
            textWrapper.appendChild(subSpan);
          }

          leftCol.appendChild(textWrapper);
          item.appendChild(leftCol);

          if (cmd.badge) {
            const badge = document.createElement('span');
            badge.className = `shrink-0 rounded-full px-2 py-0.5 text-[10px] font-semibold border ${
              isSelected
                ? 'border-white/30 text-white dark:border-zinc-900/30 dark:text-zinc-900'
                : 'border-zinc-200 bg-zinc-50 text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400'
            }`;
            badge.textContent = cmd.badge;
            item.appendChild(badge);
          }

          item.addEventListener('mouseenter', () => {
            selectedIndex = itemIdx;
            updateSelectionStyles();
          });

          item.addEventListener('click', () => {
            closePalette();
            cmd.action();
          });

          resultsContainer.appendChild(item);
        });
      });

      if (selectedIndex >= filteredCommands.length) {
        selectedIndex = Math.max(0, filteredCommands.length - 1);
      }
      updateSelectionStyles();
    }

    function updateSelectionStyles() {
      const items = resultsContainer?.querySelectorAll('[role="option"]');
      if (!items) return;

      items.forEach((elem, idx) => {
        const isSelected = idx === selectedIndex;
        elem.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        if (isSelected) {
          elem.className =
            'group flex items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-sm transition-colors cursor-pointer select-none bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 font-medium';
          elem.scrollIntoView({ block: 'nearest' });
          if (input) input.setAttribute('aria-activedescendant', elem.id);
        } else {
          elem.className =
            'group flex items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-sm transition-colors cursor-pointer select-none text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800/80';
        }
      });
    }

    function filterCommands(query: string) {
      const q = query.trim().toLowerCase();
      if (!q) {
        filteredCommands = [...allCommands];
      } else {
        filteredCommands = allCommands.filter((cmd) => {
          if (cmd.title.toLowerCase().includes(q)) return true;
          if (cmd.subtitle?.toLowerCase().includes(q)) return true;
          if (cmd.category.toLowerCase().includes(q)) return true;
          return cmd.keywords.some((k) => k.toLowerCase().includes(q));
        });
      }
      selectedIndex = 0;
      renderResults();
    }

    // Input listeners
    input.addEventListener('input', () => {
      filterCommands(input.value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (filteredCommands.length > 0) {
          selectedIndex = (selectedIndex + 1) % filteredCommands.length;
          updateSelectionStyles();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (filteredCommands.length > 0) {
          selectedIndex = (selectedIndex - 1 + filteredCommands.length) % filteredCommands.length;
          updateSelectionStyles();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        executeSelected();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closePalette();
      }
    });

    backdrop?.addEventListener('click', closePalette);
    closeBtn?.addEventListener('click', closePalette);

    if (customOpenHandler) {
      window.removeEventListener('open-command-palette', customOpenHandler);
    }
    customOpenHandler = () => openPalette();
    window.addEventListener('open-command-palette', customOpenHandler);

    if (globalKeydownHandler) {
      window.removeEventListener('keydown', globalKeydownHandler);
    }

    globalKeydownHandler = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        togglePalette();
        return;
      }

      if (e.key === '/') {
        const target = e.target as HTMLElement | null;
        const isInput = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
        if (!isInput && !isPaletteOpen) {
          e.preventDefault();
          openPalette();
          return;
        }
      }

      if (e.key === 'Escape' && isPaletteOpen) {
        e.preventDefault();
        closePalette();
      }
    };

    window.addEventListener('keydown', globalKeydownHandler);
  }

  document.addEventListener('astro:page-load', initCommandPalette);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCommandPalette);
  } else {
    initCommandPalette();
  }
</script>
