        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        aria-label="Toggle navigation menu"
      >
        <!-- Hamburger Icon -->
        <svg id="icon-hamburger" class="block h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
