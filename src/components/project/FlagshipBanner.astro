---
// src/components/project/FlagshipBanner.astro
// Dedicated Showcase Banners for Flagship Android Apps (BookReader Pro & TextMorph)
// Compliant with Astro 5, Tailwind CSS v4, and <= 500 lines rule.

interface Props {
  isBookReader?: boolean;
  isTextMorph?: boolean;
}

const { isBookReader, isTextMorph } = Astro.props;
---

{isBookReader && (
  <aside class="my-8 overflow-hidden rounded-2xl border-2 border-amber-500/30 bg-gradient-to-br from-amber-500/10 via-orange-500/5 to-amber-900/10 p-6 sm:p-8 dark:border-amber-400/30 dark:from-amber-950/40 dark:via-orange-950/20 dark:to-zinc-900 shadow-md">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-xl">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-amber-500/20 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">
            <span data-i18n="projects.flagship_showcase">Flagship Showcase</span>
          </span>
          <span class="text-xs font-medium text-amber-700 dark:text-amber-400 ltr-isolate">
            v3.4.0 • Android App
          </span>
        </div>
        <h2 class="mt-2 text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl dark:text-zinc-100">
          Interactive In-Browser TTS Simulator & App Showcase
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
          Explore the dedicated flagship showcase with the live Web Speech sentence chunker (EN, AR, FR), 3D cushion squircle icon, direct APK v3.4.0 downloads, and deep-dive into AndroidX Media3 & Jetpack Compose architecture.
        </p>
      </div>
      <div class="shrink-0">
        <a
          href="/projects/bookreader"
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-700 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-amber-600/25 hover:from-amber-500 hover:to-amber-600 dark:from-amber-500 dark:to-amber-600 dark:hover:from-amber-400 dark:hover:to-amber-500 transition-all hover:scale-[1.02] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
        >
          <span data-i18n="projects.flagship_showcase">View Flagship Showcase</span>
          <svg class="h-4 w-4 arrow-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </aside>
)}

{isTextMorph && (
  <aside class="my-8 overflow-hidden rounded-2xl border-2 border-slate-500/30 bg-gradient-to-br from-slate-500/10 via-slate-700/5 to-slate-900/10 p-6 sm:p-8 dark:border-slate-500/30 dark:from-slate-950/60 dark:via-zinc-900/70 dark:to-zinc-950 shadow-md">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-xl">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-slate-800/10 dark:bg-slate-800/60 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">
            <span data-i18n="projects.flagship_showcase">Flagship Showcase</span>
          </span>
          <span class="text-xs font-medium text-slate-600 dark:text-slate-400 ltr-isolate">
            v1.0.0 • Android App
          </span>
        </div>
        <h2 class="mt-2 text-xl font-bold tracking-tight text-zinc-900 sm:text-2xl dark:text-zinc-100">
          Interactive Android App Showcase &amp; Play Store Visuals
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
          Explore the dedicated flagship showcase with the interactive smartphone mockup, 5 authentic screens, Play Store marketing graphics, and deep-dive into its multi-engine local LLM runtime, embedded Ktor server, and AccessibilityService architecture.
        </p>
      </div>
      <div class="shrink-0">
        <a
          href="/projects/textmorph"
          class="inline-flex items-center gap-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white dark:bg-slate-100 dark:text-slate-950 dark:hover:bg-white px-5 py-3 text-sm font-semibold shadow-md transition-all hover:scale-[1.02] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-700"
        >
          <span data-i18n="projects.view_showcase">View Showcase</span>
          <svg class="h-4 w-4 arrow-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </aside>
)}
