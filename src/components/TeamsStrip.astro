---
// src/components/TeamsStrip.astro
// Teams & Companies I've Worked With Section
// Responsive Presentation:
// - Desktop (>= 1280px): Clean inline row of all 9 floating squircle icons
// - Desktop/Tablet (< 1280px): Continuous rolling marquee track (left to right, endless loop, gentle float)
// - Mobile (< 768px): Planetary spinning circle where 8 icons revolve around 1 in the center,
//   with automatic smooth place-swapping in an endless loop and tap-to-swap.

interface TeamItem {
  id: string;
  name: string;
  logo: string;
  label: string;
  href: string;
  animationDelay?: string;
}

const teams: TeamItem[] = [
  {
    id: 'sabil',
    name: 'SABIL',
    logo: '/images/logos/icons/sabil.png',
    label: 'Sabil',
    href: 'https://sabil.dz/en/getapp/',
    animationDelay: '0s',
  },
  {
    id: 'finnetude',
    name: 'Finnetude',
    logo: '/images/logos/icons/finnetude.png',
    label: 'Finnetude',
    href: '/career',
    animationDelay: '0.8s',
  },
  {
    id: 'investmarket',
    name: 'Invest Market',
    logo: '/images/logos/icons/investmarket.png',
    label: 'Invest Market',
    href: 'https://investmarket-dz.com/',
    animationDelay: '1.6s',
  },
  {
    id: 'piassa',
    name: 'PIASSA DZ',
    logo: '/images/logos/icons/piassa.png',
    label: 'Piassa',
    href: 'https://piassa.shop/',
    animationDelay: '2.4s',
  },
  {
    id: 'autoqual',
    name: 'AUTOQUAL',
    logo: '/images/logos/icons/autoqual.png',
    label: 'Autoqual',
    href: '/career',
    animationDelay: '0.4s',
  },
  {
    id: 'kabri',
    name: 'Kabri Auto',
    logo: '/images/logos/icons/kabri.png',
    label: 'Kabri Auto',
    href: '/career',
    animationDelay: '1.2s',
  },
  {
    id: 'bfln',
    name: 'BFLN Technologies',
    logo: '/images/logos/icons/bfln.png',
    label: 'BFLN Tech',
    href: '/career',
    animationDelay: '2.0s',
  },
  {
    id: 'tassouik',
    name: 'Tassouik',
    logo: '/images/logos/icons/tassouik.png',
    label: 'Tassouik',
    href: '/career',
    animationDelay: '2.8s',
  },
  {
    id: 'instaclean',
    name: 'InstaClean',
    logo: '/images/logos/icons/instaclean.png',
    label: 'InstaClean',
    href: '/career',
    animationDelay: '1.0s',
  },
];
---

<section id="teams" class="relative py-8 sm:py-12 border-t border-zinc-200/80 dark:border-zinc-800/80 overflow-hidden">
  <!-- Subtle ambient decorative glow behind floating logos -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center">
    <div class="h-64 w-96 rounded-full bg-blue-600/5 blur-3xl dark:bg-blue-500/10"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Centered & Organic) -->
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-[11px] font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 font-mono">
        Teams I've Built &amp; Collaborated With
      </p>
      <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
        Companies, Startups &amp; Platforms
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
        From national fintech mega-apps and stock brokerages to automotive SaaS and scaling e-commerce platforms.
      </p>
    </div>

    <!-- 1. DESKTOP WIDE VIEW (>= 1280px): ALL 9 ICONS INLINE WITH FLOATING MOTION -->
    <div class="hidden xl:flex items-center justify-center gap-8 max-w-6xl mx-auto mt-12">
      {teams.map((team) => (
        <a
          href={team.href}
          target={team.href.startsWith('http') ? '_blank' : undefined}
          rel={team.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="team-floating-item group flex flex-col items-center gap-2.5 transition-all duration-300 hover:scale-110"
          style={`animation-delay: ${team.animationDelay};`}
          title={`${team.name} - View Trajectory`}
          aria-label={team.name}
        >
          <div class="relative flex h-18 w-18 items-center justify-center rounded-2xl overflow-hidden shadow-md shadow-zinc-950/30 ring-1 ring-zinc-700/60 dark:ring-zinc-800 transition-all duration-300 group-hover:shadow-2xl group-hover:scale-105 group-hover:ring-blue-400">
            <img
              src={team.logo}
              alt={`${team.name} Logo`}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-102"
            />
          </div>
          <span class="text-xs font-semibold text-zinc-700 transition-colors group-hover:text-blue-600 dark:text-zinc-300 dark:group-hover:text-blue-400">
            {team.label}
          </span>
        </a>
      ))}
    </div>

    <!-- 2. DESKTOP/TABLET CONSTRAINED VIEW (768px <= width < 1280px): CONTINUOUS LEFT-TO-RIGHT ROLLING MARQUEE -->
    <div class="hidden md:block xl:hidden mt-12 relative w-full overflow-hidden teams-marquee-mask">
      <div class="teams-marquee-track flex items-center gap-8 py-3">
        <!-- Render 2 duplicated sets for seamless infinite roll from left to right -->
        {[...teams, ...teams].map((team, idx) => (
          <a
            href={team.href}
            target={team.href.startsWith('http') ? '_blank' : undefined}
            rel={team.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="team-floating-item shrink-0 group flex flex-col items-center gap-2 transition-all duration-300 hover:scale-110"
            style={`animation-delay: ${team.animationDelay};`}
            title={`${team.name} - View Trajectory`}
            aria-label={`${team.name} (${idx < teams.length ? 'Primary' : 'Duplicate'})`}
          >
            <div class="relative flex h-16 w-16 items-center justify-center rounded-2xl overflow-hidden shadow-md shadow-zinc-950/30 ring-1 ring-zinc-700/60 dark:ring-zinc-800 transition-all duration-300 group-hover:shadow-2xl group-hover:scale-105 group-hover:ring-blue-400">
              <img
                src={team.logo}
                alt={`${team.name} Logo`}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-102"
              />
            </div>
            <span class="text-[11px] font-semibold text-zinc-700 transition-colors group-hover:text-blue-600 dark:text-zinc-300 dark:group-hover:text-blue-400">
              {team.label}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- 3. MOBILE VIEW (< 768px): SPINNING CIRCULAR PLANETARY ORBIT WITH SMOOTH PLACE-SWAPPING -->
    <div class="block md:hidden mt-10">
      <div class="relative mx-auto w-[310px] h-[310px] flex items-center justify-center">
        
        <!-- Ambient Orbit Ring Indicator (Dashed Guide) -->
        <div class="absolute w-[192px] h-[192px] rounded-full border border-dashed border-blue-500/20 dark:border-blue-400/20 pointer-events-none"></div>
        <div class="absolute w-[70px] h-[70px] rounded-full bg-blue-500/5 blur-lg pointer-events-none"></div>

        <!-- Rotating Planetary Orbit Wheel -->
        <div id="mobile-orbit-wheel" class="relative w-full h-full flex items-center justify-center">
          {teams.map((team, idx) => (
            <div
              class="orbit-node absolute transition-transform duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)] cursor-pointer"
              data-team-id={team.id}
              data-team-name={team.name}
              data-team-href={team.href}
              data-index={idx}
              title={`Tap to swap ${team.name} to center`}
            >
              {/* Counter-rotating element keeps logo upright despite orbit spin */}
              <div class="orbit-counter-node flex flex-col items-center">
                <div class="node-squircle relative flex h-12 w-12 items-center justify-center rounded-xl overflow-hidden shadow-md shadow-zinc-950/40 ring-1 ring-zinc-700/60 dark:ring-zinc-800 transition-all duration-300">
                  <img
                    src={team.logo}
                    alt={`${team.name} Logo`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </div>
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Spotlight Company Label for Center Node -->
      <div class="text-center mt-3">
        <span id="orbit-spotlight-label" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold font-mono text-blue-600 bg-blue-500/10 dark:text-blue-400 border border-blue-500/20">
          SABIL
        </span>
        <p class="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1">
          Tap any orbiting company to bring it to center
        </p>
      </div>
    </div>

    <!-- Subdued CTA link to Career Journey -->
    <div class="mt-12 text-center">
      <a
        href="/career"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors group"
      >
        <span>Explore Detailed Career Journey &amp; Milestones</span>
        <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  /* 1. Organic gentle float for desktop items */
  .team-floating-item {
    animation: gentle-float 5s ease-in-out infinite alternate;
  }

  @keyframes gentle-float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-5px);
    }
    100% {
      transform: translateY(3px);
    }
  }

  /* 2. Desktop rolling marquee track: continuous roll from left to right in an endless loop */
  .teams-marquee-mask {
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  .teams-marquee-track {
    width: max-content;
    animation: roll-lr 28s linear infinite;
  }

  .teams-marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes roll-lr {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  /* 3. Mobile planetary orbit: wheel rotates, counter-nodes counter-rotate to stay upright */
  #mobile-orbit-wheel {
    animation: planetary-spin 32s linear infinite;
  }

  .orbit-counter-node {
    animation: planetary-counter-spin 32s linear infinite;
  }

  @keyframes planetary-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes planetary-counter-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }

  /* Center node spotlight styling */
  .orbit-node[data-is-center="true"] .node-squircle {
    width: 3.5rem; /* 56px */
    height: 3.5rem;
    box-shadow: 0 0 25px rgba(59, 130, 246, 0.5);
    border: 2px solid rgb(59 130 246);
  }

  @media (prefers-reduced-motion: reduce) {
    .team-floating-item,
    .teams-marquee-track,
    #mobile-orbit-wheel,
    .orbit-counter-node {
      animation: none !important;
    }
  }
</style>

<script>
  function initMobileOrbit() {
    const wheel = document.getElementById('mobile-orbit-wheel');
    const nodes = document.querySelectorAll<HTMLElement>('.orbit-node');
    const spotlightLabel = document.getElementById('orbit-spotlight-label');
    if (!wheel || nodes.length < 9) return;

    // Radius of circular orbit (in px)
    const R = 96;
    
    // Slot 0 is Center (0, 0). Slots 1..8 are the 8 positions at 45 deg intervals
    function getSlotCoords(slotIndex: number) {
      if (slotIndex === 0) {
        return { x: 0, y: 0 };
      }
      const k = slotIndex - 1; // 0 to 7
      const angleRad = (k * 45 * Math.PI) / 180;
      return {
        x: Math.round(R * Math.cos(angleRad)),
        y: Math.round(R * Math.sin(angleRad)),
      };
    }

    // slotOccupants[slotIndex] = nodeIndex
    // Initially node 0 (SABIL) is at Center (slot 0), nodes 1..8 are at slots 1..8
    let slotOccupants: number[] = [0, 1, 2, 3, 4, 5, 6, 7, 8];
    let nextSwapOrbitSlot = 1;

    function applyPositions() {
      slotOccupants.forEach((nodeIdx, slotIdx) => {
        const node = nodes[nodeIdx];
        if (!node) return;
        const coords = getSlotCoords(slotIdx);
        node.style.transform = `translate(${coords.x}px, ${coords.y}px)`;
        node.style.zIndex = slotIdx === 0 ? '30' : '10';
        node.setAttribute('data-is-center', slotIdx === 0 ? 'true' : 'false');
        
        if (slotIdx === 0 && spotlightLabel) {
          const name = node.getAttribute('data-team-name') || '';
          spotlightLabel.textContent = name;
        }
      });
    }

    function swapCenterWithSlot(targetSlot: number) {
      if (targetSlot === 0) return;
      const currentCenterNode = slotOccupants[0];
      const targetNode = slotOccupants[targetSlot];

      // Exchange slots
      slotOccupants[0] = targetNode;
      slotOccupants[targetSlot] = currentCenterNode;

      applyPositions();
    }

    // Initialize positions on load
    applyPositions();

    // Tap to swap: user taps any node to bring it to center immediately
    nodes.forEach((node, nodeIdx) => {
      node.addEventListener('click', () => {
        const currentSlot = slotOccupants.indexOf(nodeIdx);
        if (currentSlot !== 0) {
          swapCenterWithSlot(currentSlot);
          // Advance the automated sequencer so next auto-swap picks the next slot
          nextSwapOrbitSlot = (currentSlot % 8) + 1;
        }
      });
    });

    // Auto-swap interval: every 4.5 seconds exchange center with the next orbiting icon in an endless loop
    let intervalId = setInterval(() => {
      if (document.hidden) return;
      swapCenterWithSlot(nextSwapOrbitSlot);
      nextSwapOrbitSlot = (nextSwapOrbitSlot % 8) + 1;
    }, 4500);

    // Cleanup on page transitions if View Transitions are used
    document.addEventListener('astro:before-swap', () => {
      clearInterval(intervalId);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initMobileOrbit);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initMobileOrbit();
  } else {
    document.addEventListener('DOMContentLoaded', initMobileOrbit);
  }
</script>
