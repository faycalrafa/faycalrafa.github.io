---
// src/components/TeamsStrip.astro
// Teams & Companies I've Worked With Section
// Organic, floating presentation inspired by modern minimal showcases (zero rigid dark boxes)
// Provides clean white rounded containers for low-contrast logos so they appear large, sharp, and vivid.

interface TeamItem {
  name: string;
  logo: string;
  label: string;
  href: string;
  animationDelay?: string;
}

const teams: TeamItem[] = [
  {
    name: 'SABIL',
    logo: '/images/logos/icons/sabil.png',
    label: 'Sabil',
    href: 'https://sabil.dz/en/getapp/',
    animationDelay: '0s',
  },
  {
    name: 'Finnetude',
    logo: '/images/logos/icons/finnetude.png',
    label: 'Finnetude',
    href: '/career',
    animationDelay: '0.8s',
  },
  {
    name: 'Invest Market',
    logo: '/images/logos/icons/investmarket.png',
    label: 'Invest Market',
    href: 'https://investmarket-dz.com/',
    animationDelay: '1.6s',
  },
  {
    name: 'PIASSA DZ',
    logo: '/images/logos/icons/piassa.png',
    label: 'Piassa',
    href: 'https://piassa.shop/',
    animationDelay: '2.4s',
  },
  {
    name: 'AUTOQUAL',
    logo: '/images/logos/icons/autoqual.png',
    label: 'Autoqual',
    href: '/career',
    animationDelay: '0.4s',
  },
  {
    name: 'Kabri Auto',
    logo: '/images/logos/icons/kabri.png',
    label: 'Kabri Auto',
    href: '/career',
    animationDelay: '1.2s',
  },
  {
    name: 'BFLN Technologies',
    logo: '/images/logos/icons/bfln.png',
    label: 'BFLN Tech',
    href: '/career',
    animationDelay: '2.0s',
  },
  {
    name: 'Tassouik',
    logo: '/images/logos/icons/tassouik.png',
    label: 'Tassouik',
    href: '/career',
    animationDelay: '2.8s',
  },
  {
    name: 'InstaClean',
    logo: '/images/logos/icons/instaclean.png',
    label: 'InstaClean',
    href: '/career',
    animationDelay: '1.0s',
  },
];
---

<section id="teams" class="relative py-14 sm:py-20 border-t border-zinc-200/80 dark:border-zinc-800/80 overflow-hidden">
  <!-- Subtle ambient decorative glow behind floating logos -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center">
    <div class="h-64 w-96 rounded-full bg-blue-600/5 blur-3xl dark:bg-blue-500/10"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Kicker & Header (Centered & Organic) -->
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-[11px] font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 font-mono">
        Teams I've Built &amp; Collaborated With
      </p>
      <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
        Companies, Startups &amp; Platforms
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
        From national fintech mega-apps and stock brokerages to automotive SaaS and scaling e-commerce platforms.
      </p>
    </div>

    <!-- Organic Floating Logos Cluster (100% Uniform Squircle App Icons) -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-6 sm:gap-10 md:gap-12 max-w-5xl mx-auto">
      {teams.map((team) => (
        <a
          href={team.href}
          target={team.href.startsWith('http') ? '_blank' : undefined}
          rel={team.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="team-floating-item group flex flex-col items-center gap-2.5 transition-all duration-300 hover:scale-110"
          style={`animation-delay: ${team.animationDelay};`}
          title={`${team.name} - View Trajectory`}
          aria-label={team.name}
        >
          {/* Uniform Squircle Icon Container */}
          <div class="relative flex h-16 w-16 sm:h-20 sm:w-20 items-center justify-center rounded-2xl overflow-hidden shadow-md shadow-zinc-950/30 ring-1 ring-zinc-700/60 dark:ring-zinc-800 transition-all duration-300 group-hover:shadow-2xl group-hover:scale-105 group-hover:ring-blue-400">
            <img
              src={team.logo}
              alt={`${team.name} Logo`}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-102"
            />
          </div>

          {/* Clean Company Label Underneath */}
          <span class="text-xs font-semibold text-zinc-700 transition-colors group-hover:text-blue-600 dark:text-zinc-300 dark:group-hover:text-blue-400">
            {team.label}
          </span>
        </a>
      ))}
    </div>

    <!-- Subdued CTA link to Career Journey -->
    <div class="mt-12 text-center">
      <a
        href="/career"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors group"
      >
        <span>Explore Detailed Career Journey &amp; Milestones</span>
        <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  /* Organic gentle floating motion */
  .team-floating-item {
    animation: gentle-float 5s ease-in-out infinite alternate;
  }

  @keyframes gentle-float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-5px);
    }
    100% {
      transform: translateY(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-floating-item {
      animation: none !important;
    }
  }
</style>
