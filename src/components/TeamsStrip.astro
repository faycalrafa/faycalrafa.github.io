---
// src/components/TeamsStrip.astro
// Teams & Companies I've Worked With Section
// Renders authoritative company logos from local assets with mobile-first responsive layout
interface CompanyLogo {
  name: string;
  logo: string;
  heightClass?: string;
  widthClass?: string;
  invertOnDark?: boolean;
}

const companies: CompanyLogo[] = [
  { name: 'AUTOQUAL', logo: '/images/logos/autoqual-logo.png' },
  { name: 'SABIL', logo: '/images/logos/sabil-logo.png' },
  { name: 'Finnetude', logo: '/images/logos/finnetude-logo.png' },
  { name: 'InstaClean', logo: '/images/logos/instaclean-logo.webp' },
  { name: 'Kabri Auto', logo: '/images/logos/kabri-auto-logo.png' },
  { name: 'PIASSA DZ', logo: '/images/logos/piassa-logo.png' },
  { name: 'BFLN Technologies', logo: '/images/logos/BFLN-TECHNOLOGIES-.png' },
  { name: 'Tassouik', logo: '/images/logos/tassouik-logo.png' },
];
---

<section id="teams" class="relative py-12 border-t border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-50/50 dark:bg-zinc-950/40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section Kicker Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400">
          Trusted Track Record
        </p>
        <h2 class="mt-1 text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Teams &amp; Companies I've Worked With
        </h2>
      </div>

      <!-- Quick Link to Career Journey -->
      <a
        href="/career"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-500 dark:text-blue-400 dark:hover:text-blue-300 transition-colors group"
      >
        <span>View Full Career Journey</span>
        <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>

    <!-- Responsive Logo Grid (2 cols mobile, 4 cols tablet, 8 cols desktop) -->
    <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 sm:gap-4">
      {companies.map((company) => (
        <a
          href="/career"
          class="group relative flex h-24 items-center justify-center rounded-2xl border border-zinc-200/80 bg-white/80 p-4 shadow-2xs backdrop-blur-xs transition-all duration-300 hover:-translate-y-1 hover:border-zinc-300 hover:shadow-md dark:border-zinc-800/80 dark:bg-zinc-900/60 dark:hover:border-zinc-700"
          title={`${company.name} - View Career Journey`}
          aria-label={`Company: ${company.name}`}
        >
          <img
            src={company.logo}
            alt={`${company.name} Logo`}
            loading="lazy"
            decoding="async"
            class="max-h-12 w-auto max-w-[85%] object-contain opacity-80 filter transition-all duration-300 group-hover:scale-105 group-hover:opacity-100 dark:brightness-110"
          />
        </a>
      ))}
    </div>

  </div>
</section>
